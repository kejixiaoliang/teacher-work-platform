{
  "name": "teacher-work",
  "version": "0.1.0",
  "private": true,
  "description": "班主任教师工作台：班级/学生/座位/文档/值日管理（单机 Web 应用）",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
