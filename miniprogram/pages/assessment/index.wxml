<view class="page"><view class="eyebrow">日常记录</view><view class="title">表现量化</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="stats"><view><text>{{summary.positive}}</text><label>加分</label></view><view><text>{{summary.negative}}</text><label>扣分</label></view><view><text>{{summary.net}}</text><label>净分</label></view><view><text>{{summary.count}}</text><label>记录数</label></view></view><view class="toolbar"><input type="month" value="{{month}}" bindinput="onMonthInput"/><button type="primary" size="mini" bindtap="openCreate">记录表现</button></view><view wx:if="{{editing}}" class="editor"><picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex < 0 ? 0 : studentIndex}}" bindchange="selectStudent"><view class="picker">{{form.studentUuid ? studentName(form.studentUuid) : '选择学生'}}</view></picker><input class="input" type="date" value="{{form.date}}" data-field="date" bindinput="onInput"/><input class="input" placeholder="行为分类" value="{{form.categoryName}}" data-field="categoryName" bindinput="onInput"/><input class="input" placeholder="行为项目" value="{{form.itemName}}" data-field="itemName" bindinput="onInput"/><input class="input" type="number" placeholder="固定分值，可填负数" value="{{form.score}}" data-field="score" bindinput="onInput"/><textarea class="input" placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onInput"/><view class="actions"><button size="mini" bindtap="cancel">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view></view><view wx:if="{{!records.length}}" class="state">暂无表现记录</view><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text>{{studentName(item.studentUuid)}}</text><text class="score {{item.score < 0 ? 'negative' : 'positive'}}">{{item.score > 0 ? '+' : ''}}{{item.score}}</text></view><view class="meta">{{item.date || item.behaviorDate}} · {{item.categoryName || '未分类'}} · {{item.itemName}}</view><view class="content">{{item.remark || '无备注'}}</view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="openEdit">编辑</button><button size="mini" data-index="{{index}}" bindtap="remove">撤销</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
