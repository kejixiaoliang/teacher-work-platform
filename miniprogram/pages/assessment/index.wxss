@import "../../tokens.wxss";
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.toolbar,.editor,.record{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5}.picker{background:#f2c84b;font-weight:700}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:16rpx}.stats view{padding:16rpx 4rpx;text-align:center;border:3rpx solid #201b17;border-radius:12rpx;background:#8bd6af}.stats text,.stats label{display:block}.stats text{font-size:32rpx;font-weight:800}.stats label{font-size:20rpx;color:#5f554b}.toolbar{display:flex;align-items:center;gap:14rpx}.toolbar input{flex:1}.input{box-sizing:border-box;width:100%;margin-top:14rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.editor{background:#8bd6af}.record{box-shadow:4rpx 4rpx 0 #d9cbb0}.record-head{display:flex;justify-content:space-between;font-weight:800}.score{font-size:30rpx}.positive{color:#249b69}.negative{color:#d64541}.meta,.content,.state{margin-top:10rpx;color:#75695e}.content{color:#5f554b}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:16rpx}.error{margin-top:18rpx;color:#a8322e}
