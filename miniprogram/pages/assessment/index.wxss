@import "../../tokens.wxss";
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.toolbar,.editor,.record,.batch,.statistics,.history{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5}.picker{background:#f2c84b;font-weight:700}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:16rpx}.stats view{padding:16rpx 4rpx;text-align:center;border:3rpx solid #201b17;border-radius:12rpx;background:#8bd6af}.stats text,.stats label{display:block}.stats text{font-size:32rpx;font-weight:800}.stats label{font-size:20rpx;color:#5f554b}.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx}.toolbar input{flex:1}.input{box-sizing:border-box;width:100%;margin-top:14rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.editor{background:#8bd6af}.batch{background:#fff8df}.statistics{background:#eef8f1}.section-title{font-size:28rpx;font-weight:900}.section-subtitle{margin-top:20rpx;font-size:24rpx;font-weight:800}.student-check{display:inline-flex;align-items:center;width:50%;margin-top:14rpx;font-size:23rpx}.target-summary{margin-top:14rpx;padding:14rpx;border:2rpx dashed #201b17;border-radius:10rpx}.export-actions{display:flex;gap:10rpx;margin-top:14rpx}.ranking-row,.history-row{display:flex;justify-content:space-between;gap:12rpx;padding:12rpx 0;border-bottom:1rpx solid #d9cbb0;font-size:21rpx}.record{box-shadow:4rpx 4rpx 0 #d9cbb0}.record-head{display:flex;justify-content:space-between;font-weight:800}.score{font-size:30rpx}.positive{color:#249b69}.negative{color:#d64541}.meta,.content,.state{margin-top:10rpx;color:#75695e}.content{color:#5f554b}.actions{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:14rpx;margin-top:16rpx}.status-reason{margin-top:14rpx}.result{margin-top:14rpx;color:#249b69;font-weight:800}.error{margin-top:18rpx;color:#a8322e}
