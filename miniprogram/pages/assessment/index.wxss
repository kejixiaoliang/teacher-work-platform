.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.picker,.toolbar,.editor,.record{box-sizing:border-box;width:100%;margin-top:16rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:18rpx}.stats view{padding:16rpx 4rpx;text-align:center;border-radius:14rpx;background:#fef0c7}.stats text,.stats label{display:block}.stats text{font-size:32rpx;font-weight:700}.stats label{font-size:20rpx;color:#667085}.toolbar{display:flex;align-items:center;gap:14rpx}.toolbar input{flex:1}.input{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:1rpx solid #eadfd5;border-radius:12rpx}.record-head{display:flex;justify-content:space-between;font-weight:700}.score{font-size:30rpx}.positive{color:#249b69}.negative{color:#d95045}.meta,.content,.state{margin-top:10rpx;color:#667085}.content{color:#344054}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:16rpx}.error{margin-top:18rpx;color:#b42318}
