<view class="page"><view class="eyebrow">工作台模块</view><view class="title">{{feature}}</view><picker wx:if="{{classes.length}}" mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view wx:if="{{feature !== '数据分析'}}" class="toolbar"><button size="mini" bindtap="openCreate">新增记录</button></view><view wx:if="{{editing}}" class="editor"><block wx:for="{{config.fields}}" wx:key="*this"><input class="input" placeholder="{{item}}" data-field="{{item}}" value="{{form[item]}}" bindinput="onInput"/></block><view class="actions"><button size="mini" bindtap="cancelEdit">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view></view><view wx:if="{{loading}}" class="state">正在读取…</view><view wx:elif="{{error}}" class="state error">{{error}}</view><block wx:elif="{{feature === '数据分析'}}"><view wx:for="{{summaryRows}}" wx:key="*this" class="summary"><text>{{item[0]}}</text><text>{{item[1]}}</text></view></block><view wx:elif="{{!records.length}}" class="state">暂无记录</view><view wx:else class="record-list"><view wx:for="{{records}}" wx:key="uuid" class="record"><view>{{item.title || item.name || item.subject || item.role || item.method || '业务记录'}}</view><view class="meta">{{item.remark || item.content || item.result || item.date || item.score || ''}}</view><button size="mini" data-uuid="{{item.uuid}}" bindtap="remove">删除</button></view></view></view>
