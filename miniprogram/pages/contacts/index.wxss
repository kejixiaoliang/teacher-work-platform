.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.picker,.input,.filters{box-sizing:border-box;width:100%;margin-top:16rpx;padding:18rpx 20rpx;border:1rpx solid #eadfd5;border-radius:14rpx;background:#fffdf9;color:#475467}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:18rpx}.stats view{padding:16rpx 4rpx;text-align:center;border-radius:14rpx;background:#fef0c7}.stats text,.stats label{display:block}.stats text{font-size:34rpx;font-weight:700;color:#1d2939}.stats label{margin-top:6rpx;font-size:20rpx;color:#667085}.filters{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.filters input{width:55%}.editor,.record{margin-top:16rpx;padding:22rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:16rpx}.record-head{display:flex;justify-content:space-between;font-weight:700}.method{color:#b54708}.meta,.content{margin-top:10rpx;color:#667085}.content{color:#344054}.state{margin-top:28rpx;color:#667085}.error{margin-top:18rpx;color:#b42318}
