@import "../../tokens.wxss";
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.input,.filters{box-sizing:border-box;width:100%;margin-top:14rpx;padding:16rpx 18rpx;border:3rpx solid #201b17;border-radius:10rpx;background:#fffdf5;color:#201b17}.picker{background:#f2c84b;font-weight:700}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:16rpx}.stats view{padding:16rpx 4rpx;text-align:center;border:3rpx solid #201b17;border-radius:12rpx;background:#8bd6af}.stats text,.stats label{display:block}.stats text{font-size:34rpx;font-weight:800;color:#201b17}.stats label{margin-top:6rpx;font-size:20rpx;color:#5f554b}.filters{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.filters input{width:55%}.editor,.record{margin-top:14rpx;padding:20rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5;box-shadow:4rpx 4rpx 0 #d9cbb0}.editor{background:#8bd6af}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:16rpx}.record-head{display:flex;justify-content:space-between;font-weight:800}.method{color:#d64541}.meta,.content{margin-top:10rpx;color:#75695e}.content{color:#5f554b}.state{margin-top:24rpx;padding:18rpx;border:2rpx dashed #201b17;color:#5f554b}.error{margin-top:18rpx;color:#a8322e}
