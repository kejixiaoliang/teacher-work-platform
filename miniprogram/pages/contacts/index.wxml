<view class="page"><view class="eyebrow">班级事务</view><view class="title">家校沟通</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="stats"><view><text>{{stats.total}}</text><label>沟通次数</label></view><view><text>{{stats.students}}</text><label>涉及学生</label></view><view><text>{{stats.visits}}</text><label>家访</label></view><view><text>{{stats.phones}}</text><label>电话</label></view></view><view class="filters"><input type="month" value="{{month}}" bindinput="onMonthInput"/><button type="primary" size="mini" bindtap="openCreate">新增沟通</button></view><view wx:if="{{editing}}" class="editor"><picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex < 0 ? 0 : studentIndex}}" bindchange="selectStudent"><view class="picker">{{form.studentUuid ? studentName(form.studentUuid) : '选择学生'}}</view></picker><input class="input" type="date" value="{{form.date}}" data-field="date" bindinput="onInput"/><picker mode="selector" range="{{methods}}" value="{{methodIndex}}" bindchange="selectMethod"><view class="picker">{{form.method}}</view></picker><input class="input" placeholder="沟通主题" value="{{form.topic}}" data-field="topic" bindinput="onInput"/><textarea class="input" placeholder="沟通结果" value="{{form.result}}" data-field="result" bindinput="onInput"/><textarea class="input" placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onInput"/><view class="actions"><button size="mini" bindtap="cancel">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view></view><view wx:if="{{!records.length}}" class="state">暂无沟通记录</view><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text>{{studentName(item.studentUuid)}}</text><text class="method">{{item.method}}</text></view><view class="meta">{{item.date}} · {{item.topic || '未填写主题'}}</view><view class="content">{{item.result || item.remark || '未填写结果'}}</view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="openEdit">编辑</button><button size="mini" data-index="{{index}}" bindtap="remove">删除</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>

