<view class="page"><view class="eyebrow">班级事务</view><view class="title">家校沟通</view><picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="selectClass"><view class="picker">班级：{{classes[classIndex].name || '请选择'}}</view></picker><view class="stats"><view><text>{{stats.total}}</text><label>沟通次数</label></view><view><text>{{stats.students}}</text><label>涉及学生</label></view><view><text>{{stats.visits}}</text><label>家访</label></view><view><text>{{stats.phones}}</text><label>电话</label></view></view><view class="filters"><picker mode="date" fields="month" value="{{month}}" bindchange="onMonthInput"><view class="filter-field">月份：{{month || '全部'}}</view></picker><picker mode="selector" range="{{filterStudents}}" range-key="name" data-field="studentFilter" bindchange="onFilterPicker"><view class="filter-field">按学生筛选</view></picker><picker mode="selector" range="{{filterMethods}}" data-field="methodFilter" bindchange="onFilterPicker"><view class="filter-field">按方式筛选</view></picker><input class="filter-field" placeholder="关键词：学生/学号/事由/结果" value="{{keyword}}" data-field="keyword" bindinput="onFilterInput"/><button type="primary" size="mini" bindtap="openCreate">新增沟通</button><button size="mini" bindtap="exportCsv">导出沟通台账 CSV</button></view><view wx:if="{{editing}}" class="editor"><picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex < 0 ? 0 : studentIndex}}" bindchange="selectStudent"><view class="picker">{{studentIndex >= 0 ? students[studentIndex].name : '选择学生'}}</view></picker><picker mode="date" value="{{form.date}}" data-field="date" bindchange="onInput"><view class="picker">日期：{{form.date || '请选择'}}</view></picker><picker mode="selector" range="{{methods}}" value="{{methodIndex}}" bindchange="selectMethod"><view class="picker">{{form.method}}</view></picker><input class="input" placeholder="沟通主题" value="{{form.topic}}" data-field="topic" bindinput="onInput"/><textarea class="input" placeholder="沟通结果" value="{{form.result}}" data-field="result" bindinput="onInput"/><textarea class="input" placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onInput"/><view class="actions"><button size="mini" bindtap="cancel">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view></view><view wx:if="{{!visibleRecords.length}}" class="state">暂无沟通记录</view><view wx:for="{{visibleRecords}}" wx:key="uuid" class="record"><view class="record-head"><text>{{item.studentName}}</text><text class="method">{{item.method}}</text></view><view class="meta">{{item.schoolNo || '无学号'}} · {{item.date}} · {{item.topic || '未填写主题'}}</view><view class="content">{{item.result || item.remark || '未填写结果'}}</view><view class="actions"><button size="mini" data-uuid="{{item.uuid}}" bindtap="openEdit">编辑</button><button size="mini" data-uuid="{{item.uuid}}" bindtap="remove">删除</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>

