@import "../../tokens.wxss";.page{min-height:100vh;padding:28rpx 24rpx 48rpx}.eyebrow{color:var(--tomato);font-size:20rpx;font-weight:800;letter-spacing:2rpx}.title{margin:10rpx 0;font-size:48rpx;font-weight:900}.subtitle,.summary,.date{color:var(--muted);font-size:24rpx;line-height:1.6}.release{margin-top:18rpx;padding:20rpx;border:2rpx solid var(--line);border-radius:16rpx;background:#fffdf4;box-shadow:4rpx 4rpx 0 var(--ink)}.release-head{display:flex;justify-content:space-between;align-items:center}.version{padding:6rpx 10rpx;border-radius:999rpx;background:var(--mustard);color:var(--ink);font-weight:900}.release-title{display:block;margin-top:14rpx;font-size:28rpx;font-weight:900}.summary{display:block;margin-top:8rpx}.maker{margin-top:28rpx;padding:20rpx;border:2rpx solid var(--ink);border-radius:14rpx;background:var(--mint);font-size:24rpx;font-weight:800}
