@import "../../tokens.wxss";
.file-row{display:flex;align-items:center;gap:12rpx;margin-top:14rpx;color:#5f554b}.file-row text{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-note{margin-top:8rpx;color:#75695e;font-size:20rpx}
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.hint,.toolbar,.editor,.record{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5}.picker{background:#f2c84b;font-weight:700}.hint{color:#75695e;font-size:22rpx;line-height:1.6;background:#93c9d8}.toolbar{display:flex;align-items:center;gap:14rpx}.toolbar input{flex:1}.input{box-sizing:border-box;width:100%;margin-top:14rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.record{box-shadow:4rpx 4rpx 0 #d9cbb0}.record-head{display:flex;justify-content:space-between;font-weight:800}.category{color:#d64541}.meta,.state{margin-top:10rpx;color:#75695e}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:16rpx}.error{margin-top:18rpx;color:#a8322e}
