<view class="page"><view class="eyebrow">班级事务</view><view class="title">文档管理</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="hint">小程序当前管理文档元数据；文件上传与预览仍由客户端负责，后续再接入云存储。</view><picker mode="selector" range="{{categories}}" bindchange="selectCategory"><view class="picker">分类：{{category}}</view></picker><view class="toolbar"><input placeholder="搜索文档名称" value="{{keyword}}" bindinput="onKeyword"/><button type="primary" size="mini" bindtap="openCreate">新增文档</button></view><view wx:if="{{editing}}" class="editor"><input class="input" placeholder="文档名称" value="{{form.name}}" data-field="name" bindinput="onInput"/><input class="input" placeholder="分类" value="{{form.category}}" data-field="category" bindinput="onInput"/><input class="input" placeholder="标签" value="{{form.tag}}" data-field="tag" bindinput="onInput"/><textarea class="input" placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onInput"/><view class="actions"><button size="mini" bindtap="cancel">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view></view><view wx:if="{{!records.length}}" class="state">暂无文档元数据</view><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text>{{item.name || item.fileName || '未命名文档'}}</text><text class="category">{{item.category || '其他'}}</text></view><view class="meta">标签：{{item.tag || '无'}} · {{item.remark || '无备注'}}</view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="openEdit">编辑</button><button size="mini" data-index="{{index}}" bindtap="remove">删除</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>

