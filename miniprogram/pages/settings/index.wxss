@import "../../tokens.wxss";
.page { min-height:100vh; padding:44rpx 32rpx 96rpx; }
.topline,.group-head { display:flex; align-items:center; justify-content:space-between; }
.eyebrow,.section-kicker { color:#c65a32; font-size:20rpx; letter-spacing:3rpx; font-weight:700; }
.status-dot { color:#74836e; font-size:22rpx; }
.title { margin:12rpx 0 10rpx; color:#201b17; font-family:"Noto Serif SC","Songti SC",serif; font-size:56rpx; font-weight:900; letter-spacing:-2rpx; }
.hint { max-width:600rpx; color:#74808a; font-size:27rpx; line-height:1.7; }
.group { margin-top:30rpx; }
.group-head { align-items:flex-end; margin-bottom:12rpx; }
.section-title { display:block; margin-top:5rpx; color:#201b17; font-size:29rpx; font-weight:900; }
.group-index { color:#cfc8bb; font-family:"DIN Alternate","Courier New",monospace; font-size:34rpx; }
.setting-list { overflow:hidden; border:2rpx solid #201b17; border-radius:12rpx; background:#fffdf5; box-shadow:3rpx 3rpx 0 #201b17; }
.setting-row { display:flex; align-items:center; justify-content:space-between; min-height:62rpx; padding:0 18rpx; border-bottom:1rpx solid #d9cbb0; color:#201b17; }
.setting-row:active { background:#f1eadf; }
.setting-row:last-child { border-bottom:0; }
.setting-row text:first-child { font-size:25rpx; }
.chevron { color:#d64541; font-size:24rpx; line-height:1; }
.section-note { display:block; margin-top:6rpx; color:#685f55; font-size:21rpx; }
.group-mustard .setting-row:first-child { background:#f2c84b; }
.group-mint .setting-row:first-child { background:#8bd6af; }
.group-sky .setting-row:first-child { background:#93c9d8; }
