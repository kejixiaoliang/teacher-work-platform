@import "../../tokens.wxss";
.page { padding:0; }
.topline,.group-head { display:flex; align-items:center; justify-content:space-between; }
.eyebrow,.section-kicker { color:#c65a32; font-size:20rpx; letter-spacing:3rpx; font-weight:700; }
.status-dot { color:#74836e; font-size:22rpx; }
.title { margin:14rpx 0 12rpx; color:#202a32; font-family:"Noto Serif SC","Songti SC",serif; font-size:64rpx; font-weight:700; letter-spacing:-2rpx; }
.hint { max-width:600rpx; color:#74808a; font-size:27rpx; line-height:1.7; }
.group { margin-top:52rpx; }
.group-head { align-items:flex-end; margin-bottom:18rpx; }
.section-title { display:block; margin-top:8rpx; color:#202a32; font-size:30rpx; font-weight:700; }
.group-index { color:#cfc8bb; font-family:"DIN Alternate","Courier New",monospace; font-size:34rpx; }
.setting-list { overflow:hidden; border:1rpx solid #ded8cc; border-radius:16rpx; background:#fffdf8; box-shadow:0 10rpx 24rpx rgba(52,45,35,.05); }
.setting-row { display:flex; align-items:center; justify-content:space-between; min-height:82rpx; padding:0 26rpx; border-bottom:1rpx solid #eee9df; color:#34424a; }
.setting-row:active { background:#f1eadf; }
.setting-row:last-child { border-bottom:0; }
.setting-row text:first-child { font-size:27rpx; }
.chevron { color:#c65a32; font-size:30rpx; line-height:1; }
.section-note { display:block; margin-top:8rpx; color:#685f55; font-size:22rpx; }
.group-mustard .setting-list,.group-mint .setting-list,.group-sky .setting-list { box-shadow:6rpx 6rpx 0 #201b17; }
.group-mustard .setting-row:first-child { background:#f2c84b; }
.group-mint .setting-row:first-child { background:#8bd6af; }
.group-sky .setting-row:first-child { background:#93c9d8; }
