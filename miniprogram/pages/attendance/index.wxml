<view class="page">
  <view class="eyebrow">学习分析</view>
  <view class="title">考勤管理</view>
  <view class="filters">
    <view class="view-tabs"><view class="tab {{view === 'daily' ? 'active' : ''}}" data-view="daily" bindtap="switchView">每日登记</view><view class="tab {{view === 'monthly' ? 'active' : ''}}" data-view="monthly" bindtap="switchView">月度统计</view></view>
    <picker mode="date" value="{{date}}" start="2020-01-01" end="2099-12-31" bindchange="onDateChange"><view class="picker">日期：{{date}}</view></picker>
    <picker wx:if="{{view === 'monthly'}}" mode="date" fields="month" value="{{month}}" start="2020-01" end="2099-12" bindchange="onMonthChange"><view class="picker">月份：{{month}}</view></picker>
    <picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">{{classUuid ? '切换班级' : '选择班级'}}</view></picker>
    <button wx:if="{{view === 'daily'}}" size="mini" bindtap="markAllPresent">一键全部出勤</button>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取考勤…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{!rows.length}}" class="state">当前班级暂无学生</view>
  <block wx:elif="{{view === 'daily'}}">
    <view wx:for="{{rows}}" wx:key="studentUuid" class="row">
      <view class="student"><text class="name">{{item.name}}</text><text class="school-no">{{item.schoolNo}}</text></view>
      <picker mode="selector" range="{{statuses}}" value="{{statuses.indexOf(item.status)}}" data-index="{{index}}" bindchange="onStatusChange"><view class="status">{{item.status}}</view></picker>
      <input class="remark" placeholder="备注" value="{{item.remark}}" data-index="{{index}}" bindinput="onRemarkInput" />
    </view>
    <button type="primary" loading="{{saving}}" bindtap="save">保存当天考勤</button>
  </block>
  <block wx:else>
    <view wx:if="{{!monthlyRows.length}}" class="state">本月暂无考勤记录</view>
    <view wx:for="{{monthlyRows}}" wx:key="studentUuid" class="monthly-row"><text class="name">{{item.name}}</text><text>出勤 {{item.present}}</text><text>迟到 {{item.late}}</text><text>请假 {{item.leave}}</text><text>缺勤 {{item.absent}}</text><text>合计 {{item.total}} 天</text></view>
  </block>
</view>

