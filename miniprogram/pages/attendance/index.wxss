.page { padding: 40rpx 32rpx 60rpx; }
.eyebrow { color: #b54708; font-size: 24rpx; letter-spacing: 2rpx; }
.title { margin-top: 10rpx; color: #1d2939; font-size: 48rpx; font-weight: 700; }
.filters { display: flex; gap: 16rpx; margin-top: 28rpx; }
.picker { padding: 18rpx 20rpx; border: 1rpx solid #eadfd5; border-radius: 14rpx; background: #fffdf9; color: #475467; }
.state { margin-top: 28rpx; color: #667085; line-height: 1.6; }
.error { color: #b42318; }
.row { display: grid; grid-template-columns: 1fr auto; gap: 14rpx; align-items: center; margin-top: 16rpx; padding: 22rpx 20rpx; border: 1rpx solid #eadfd5; border-radius: 16rpx; background: #fffdf9; }
.student { min-width: 0; }
.name { display: block; color: #1d2939; font-size: 30rpx; font-weight: 600; }
.school-no { display: block; margin-top: 6rpx; color: #667085; font-size: 23rpx; }
.status { padding: 12rpx 18rpx; border-radius: 12rpx; background: #fef0c7; color: #93370d; }
.remark { grid-column: 1 / -1; padding: 14rpx; border-bottom: 1rpx solid #eadfd5; color: #475467; }
button { margin-top: 28rpx; }
