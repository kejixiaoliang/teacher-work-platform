@import "../../tokens.wxss";

.page { padding: 34rpx 32rpx 64rpx; }
.eyebrow { color: #b54708; font-size: 24rpx; letter-spacing: 2rpx; }
.title { margin-top: 10rpx; color: #1d2939; font-size: 48rpx; font-weight: 700; }
.filters { display: flex; gap: 16rpx; margin-top: 28rpx; }
.picker { padding: 18rpx 20rpx; border: 1rpx solid #eadfd5; border-radius: 14rpx; background: #fffdf9; color: #475467; }
.state { margin-top: 28rpx; color: #667085; line-height: 1.6; }
.error { color: #b42318; }
.row { display: grid; grid-template-columns: 1fr auto; gap: 14rpx; align-items: center; margin-top: 16rpx; padding: 22rpx 20rpx; border: 1rpx solid #eadfd5; border-radius: 16rpx; background: #fffdf9; }
.student { min-width: 0; }
.name { display: block; color: #1d2939; font-size: 30rpx; font-weight: 600; }
.school-no { display: block; margin-top: 6rpx; color: #667085; font-size: 23rpx; }
.leave-link { display: inline-block; margin-top: 8rpx; padding: 3rpx 9rpx; border: 1rpx solid #d64541; border-radius: 999rpx; color: #d64541; font-size: 20rpx; }
.status { padding: 12rpx 18rpx; border-radius: 12rpx; background: #fef0c7; color: #93370d; }
.remark { grid-column: 1 / -1; padding: 14rpx; border-bottom: 1rpx solid #eadfd5; color: #475467; }
button { margin-top: 28rpx; }

.eyebrow { color: #d64541; font-weight: 700; letter-spacing: 3rpx; }
.title { color: #201b17; font-family: "Noto Serif SC", "Songti SC", serif; font-weight: 900; }
.picker { border: 3rpx solid #201b17; border-radius: 10rpx; background: #f2c84b; color: #201b17; font-weight: 700; }
.state { padding: 22rpx; border: 2rpx dashed #201b17; border-radius: 12rpx; color: #5f554b; }
.error { border-color: #d64541; color: #a8322e; }
.row { border: 3rpx solid #201b17; border-radius: 12rpx; background: #fffdf5; box-shadow: 4rpx 4rpx 0 #d9cbb0; }
.name { color: #201b17; font-weight: 800; }
.school-no { color: #75695e; }
.status { border: 2rpx solid #201b17; border-radius: 999rpx; background: #8bd6af; color: #201b17; font-weight: 700; }
.remark { border-bottom: 2rpx solid #d9cbb0; color: #5f554b; }
.view-tabs { display: flex; gap: 18rpx; width: 100%; }
.tab { padding: 12rpx 18rpx; color: #5f554b; border-bottom: 4rpx solid transparent; font-weight: 700; }
.tab.active { color: #d64541; border-color: #d64541; }
.monthly-row { display: grid; grid-template-columns: 1.3fr repeat(5, 1fr); gap: 10rpx; align-items: center; margin-top: 14rpx; padding: 20rpx 14rpx; border: 3rpx solid #201b17; border-radius: 12rpx; background: #fffdf5; box-shadow: 4rpx 4rpx 0 #d9cbb0; font-size: 22rpx; }
