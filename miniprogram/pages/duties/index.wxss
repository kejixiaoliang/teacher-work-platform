.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.picker,.auto,.group,.editor,.roster{box-sizing:border-box;width:100%;margin-top:16rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.toolbar{display:flex;gap:12rpx;margin-top:16rpx}.auto{display:flex;gap:14rpx;align-items:center}.auto input,.roster input{width:120rpx;padding:12rpx;border:1rpx solid #eadfd5;border-radius:10rpx}.group-head,.roster{display:flex;align-items:center;gap:14rpx}.badge{padding:8rpx 14rpx;border:2rpx solid #1d2939;border-radius:999rpx;background:#fef0c7;font-weight:700}.days{margin-left:auto;color:#667085;font-size:22rpx}.members{display:flex;flex-wrap:wrap;gap:10rpx;margin:18rpx 0}.chip{padding:8rpx 14rpx;border-radius:999rpx;background:#e7f8f3;color:#1d2939;font-size:22rpx}.day-list{display:flex;gap:12rpx;margin:18rpx 0}.day{padding:12rpx 14rpx;border:1rpx solid #eadfd5;border-radius:12rpx;color:#667085}.day.active{background:#fef0c7;border:2rpx solid #b54708;color:#1d2939}.state{margin-top:28rpx;color:#667085}.error{margin-top:18rpx;color:#b42318}
