@import "../../tokens.wxss";

.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.auto,.group,.editor,.roster,.new-group,.roster-table{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#fffdf5}.picker{background:#f2c84b;font-weight:700}.toolbar{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.auto{display:flex;gap:14rpx;align-items:center;background:#8bd6af;box-shadow:4rpx 4rpx 0 #201b17}.auto input,.roster input,.new-group input,.rename input,.roster-controls input{width:120rpx;padding:12rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.new-group,.rename,.roster-controls{display:flex;align-items:center;gap:12rpx}.group-head,.roster{display:flex;align-items:center;gap:14rpx}.badge{padding:8rpx 14rpx;border:2rpx solid #201b17;border-radius:999rpx;background:#f2c84b;color:#201b17;font-weight:800}.days{margin-left:auto;color:#75695e;font-size:22rpx}.members{display:flex;flex-wrap:wrap;gap:10rpx;margin:16rpx 0}.chip{padding:8rpx 14rpx;border:2rpx solid #201b17;border-radius:999rpx;background:#8bd6af;color:#201b17;font-size:22rpx}.section-title{margin-bottom:14rpx;font-size:28rpx;font-weight:900}.danger{color:#a8322e}.day-list{display:flex;flex-wrap:wrap;gap:10rpx;margin:16rpx 0}.day{padding:12rpx 14rpx;border:2rpx solid #d9cbb0;border-radius:12rpx;color:#75695e}.day.active{background:#f2c84b;border:3rpx solid #201b17;color:#201b17}.member-editor{margin-top:18rpx}.member-line,.roster-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:12rpx 0;border-bottom:1rpx solid #d9cbb0}.roster-table{background:#eef8f1}.roster-row{font-size:21rpx}.state{margin-top:24rpx;padding:18rpx;border:2rpx dashed #201b17;color:#5f554b}.error{margin-top:18rpx;color:#a8322e}
