<view class="page"><view class="eyebrow">班级事务</view><view class="title">值日管理</view><picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="selectClass"><view class="picker">班级：{{classes[classIndex].name || '请选择班级'}}</view></picker><view class="toolbar"><button size="mini" bindtap="preset" data-action="presetLeaders">预设班委</button><button size="mini" bindtap="preset" data-action="presetSubjectLeaders">预设课代表</button><button size="mini" bindtap="copyExport">复制值日 JSON</button></view>
<view class="auto"><input type="number" value="{{groupCount}}" bindinput="onGroupCountInput" placeholder="组数"/><button type="primary" size="mini" loading="{{saving}}" bindtap="autoGroup">一键自动分组</button></view><view class="new-group"><input type="number" value="{{newGroupNo}}" data-field="newGroupNo" bindinput="onGroupNumber"/><button size="mini" bindtap="startNewGroup">新增组</button></view>
<view wx:if="{{!groups.length}}" class="state">暂无值日分组，请先新增组或自动分组。</view><view wx:for="{{groups}}" wx:key="no" class="group"><view class="group-head"><text class="badge">第 {{item.no}} 组</text><text>{{item.members.length}} 人</text><text class="days">{{item.groupDays ? '值日：' + item.groupDays : '未设置星期'}}</text></view><view class="members"><text wx:for="{{item.members}}" wx:key="uuid" class="chip">{{item.studentName}}</text></view><button size="mini" data-index="{{index}}" bindtap="openGroup">编辑组</button></view>
<view wx:if="{{selectedGroup}}" class="editor"><view class="section-title">编辑第 {{selectedGroup}} 组</view><view class="rename"><input type="number" value="{{renameGroupNo}}" data-field="renameGroupNo" bindinput="onGroupNumber"/><button size="mini" bindtap="renameGroup">修改组号</button><button class="danger" size="mini" bindtap="deleteGroup">删除整组</button></view><view>设置值日星期</view><view class="day-list"><text wx:for="{{weekNames}}" wx:key="*this" class="day {{selectedDays.indexOf(String(index + 1)) >= 0 ? 'active' : ''}}" data-day="{{index + 1}}" bindtap="toggleDay">{{item}}</text></view><button type="primary" size="mini" loading="{{saving}}" bindtap="saveDays">保存星期</button><view class="member-editor"><picker mode="selector" range="{{students}}" range-key="name" bindchange="onMemberPicker"><view class="picker">选择要加入的学生</view></picker><button size="mini" bindtap="addMember">加入当前值日组</button><view wx:for="{{groups}}" wx:if="{{item.no === selectedGroup}}" wx:key="no"><view wx:for="{{item.members}}" wx:key="uuid" class="member-line"><text>{{item.studentName}}</text><button size="mini" data-index="{{index}}" bindtap="removeMember">移除</button></view></view></view></view>
<view class="roster"><text>第 {{week}} 周值日组：</text><input type="number" value="{{week}}" bindinput="onWeekInput"/><text wx:if="{{groups.length}}">第 {{groups[(week - 1) % groups.length].no}} 组</text></view><view class="roster-table"><view class="section-title">完整轮换表</view><view class="roster-controls"><input type="number" value="{{rosterWeeks}}" bindinput="onRosterWeeks"/><button size="mini" bindtap="exportRosterCsv">导出值日表 CSV</button></view><view wx:for="{{rosterRows}}" wx:key="week" class="roster-row"><text>第 {{item.week}} 周 · 第 {{item.groupNo}} 组</text><text>{{item.groupDays || '按周轮换'}} · {{item.members}}</text></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
