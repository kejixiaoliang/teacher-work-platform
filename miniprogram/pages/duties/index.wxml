<view class="page"><view class="eyebrow">日常记录</view><view class="title">值日管理</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="toolbar"><button size="mini" bindtap="preset" data-action="presetLeaders">预设班委</button><button size="mini" bindtap="preset" data-action="presetSubjectLeaders">预设课代表</button></view><view class="auto"><input type="number" value="{{groupCount}}" bindinput="onGroupCountInput" placeholder="组数"/><button type="primary" size="mini" loading="{{saving}}" bindtap="autoGroup">一键自动分组</button></view><view wx:if="{{!groups.length}}" class="state">暂无值日分组，请先自动分组。</view><view wx:for="{{groups}}" wx:key="no" class="group"><view class="group-head"><text class="badge">第 {{item.no}} 组</text><text>{{item.members.length}} 人</text><text class="days">{{item.groupDays ? '值日：' + item.groupDays : '未设置星期'}}</text></view><view class="members"><text wx:for="{{item.members}}" wx:key="uuid" class="chip">{{studentName(item.studentUuid)}}</text></view><button size="mini" data-index="{{index}}" bindtap="openGroup">设置值日星期</button></view><view wx:if="{{selectedGroup}}" class="editor"><view>第 {{selectedGroup}} 组固定值日星期</view><view class="day-list"><text wx:for="{{weekNames}}" wx:key="*this" class="day {{selectedDays.indexOf(String(index + 1)) >= 0 ? 'active' : ''}}" data-day="{{index + 1}}" bindtap="toggleDay">{{item}}</text></view><button type="primary" size="mini" loading="{{saving}}" bindtap="saveDays">保存星期</button></view><view class="roster"><text>第 {{week}} 周值日组：</text><input type="number" value="{{week}}" bindinput="onWeekInput"/><text wx:if="{{groups.length}}">第 {{groups[(week - 1) % groups.length].no}} 组</text></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
