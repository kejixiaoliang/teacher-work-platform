<view class="page"><view class="eyebrow">表现量化</view><view class="title">规则管理</view><view class="toolbar"><button size="mini" bindtap="openCategory">新增分类</button><button size="mini" bindtap="openItem">新增行为项目</button></view><view class="section-title">分类</view><view wx:for="{{categories}}" wx:key="uuid" class="card"><view><text>{{item.name}}</text><text class="meta">{{item.isActive ? '启用中' : '已停用'}}</text></view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="openCategoryEdit">编辑</button><button size="mini" data-collection="assessment_categories" data-index="{{index}}" bindtap="remove">删除</button></view></view><view class="section-title">行为项目</view><view wx:for="{{items}}" wx:key="uuid" class="card"><view><text>{{item.name}}</text><text class="meta">{{item.score > 0 ? '+' : ''}}{{item.score}} 分 · {{item.description || '无说明'}}</text></view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="openItemEdit">编辑</button><button size="mini" data-collection="assessment_items" data-index="{{index}}" bindtap="remove">删除</button></view></view><view wx:if="{{editing || itemEditing}}" class="editor"><input class="input" placeholder="名称" value="{{form.name}}" data-field="name" bindinput="onInput"/><picker wx:if="{{itemEditing}}" mode="selector" range="{{categories}}" range-key="name" bindchange="selectCategory"><view class="picker">选择所属分类</view></picker><input wx:if="{{itemEditing}}" class="input" type="number" placeholder="固定分值" value="{{form.score}}" bindinput="onScore"/><input wx:if="{{itemEditing}}" class="input" placeholder="说明" value="{{form.description}}" data-field="description" bindinput="onInput"/><button wx:if="{{itemEditing}}" size="mini" bindtap="toggleRepeat">{{form.allowDailyRepeat ? '当天允许重复' : '当天不允许重复'}}</button><button wx:else size="mini" bindtap="toggleActive">{{form.isActive ? '当前启用' : '当前停用'}}</button><view class="actions"><button size="mini" bindtap="cancel">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="saveRule">保存</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
