.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.toolbar,.card,.editor{margin-top:16rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.toolbar{display:flex;gap:14rpx}.section-title{margin-top:28rpx;font-weight:700;color:#1d2939}.card{display:flex;justify-content:space-between;align-items:center}.meta{display:block;margin-top:8rpx;color:#667085;font-size:22rpx}.input,.picker{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:1rpx solid #eadfd5;border-radius:12rpx}.actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:14rpx}.error{margin-top:18rpx;color:#b42318}
