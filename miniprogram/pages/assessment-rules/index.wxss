@import "../../tokens.wxss";
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.toolbar,.card,.editor{margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5}.toolbar{display:flex;gap:14rpx;background:#f2c84b}.section-title{margin-top:24rpx;color:#201b17;font-weight:800}.card{display:flex;justify-content:space-between;align-items:center;box-shadow:4rpx 4rpx 0 #d9cbb0}.editor{background:#8bd6af}.meta{display:block;margin-top:8rpx;color:#75695e;font-size:22rpx}.input,.picker{box-sizing:border-box;width:100%;margin-top:14rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:14rpx}.error{margin-top:18rpx;color:#a8322e}
