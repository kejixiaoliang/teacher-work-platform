@import "../../tokens.wxss";
.page{min-height:100vh;padding:34rpx 32rpx 96rpx;background:#fff4dc;color:#201b17}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 10rpx;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.hint,.meta{color:#685f55;font-size:24rpx;line-height:1.6}.toolbar{display:flex;gap:12rpx;margin-top:20rpx}.picker,.editor input{box-sizing:border-box;width:100%;margin-top:12rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5}.editor{margin-top:20rpx;padding:20rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#8bd6af;box-shadow:4rpx 4rpx #201b17}.actions{display:flex;justify-content:flex-end;gap:10rpx;margin-top:14rpx}.record{margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5;box-shadow:3rpx 3rpx #d9cbb0}.record-head{display:flex;justify-content:space-between;align-items:center}.role{padding:8rpx 12rpx;border:2rpx solid #201b17;border-radius:999rpx;background:#f2c84b;font-weight:800}.name{font-weight:800}.state{margin-top:20rpx;padding:18rpx;border:2rpx dashed #201b17;color:#685f55}.error{color:#a8322e;border-color:#d64541}
