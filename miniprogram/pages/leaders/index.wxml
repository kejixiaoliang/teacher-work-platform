<view class="page"><view class="eyebrow">班级事务 / 常用</view><view class="title">班委学委</view><view class="hint">选任固定班委，同一职务只能由一名学生担任；若职务或人员冲突，会在保存前提示。</view><picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="selectClass"><view class="picker">班级：{{classes[classIndex].name || '请选择班级'}}</view></picker><view class="toolbar"><button size="mini" bindtap="preset" loading="{{saving}}">一键预设班委</button><button size="mini" bindtap="openCreate">选任班委</button></view><view wx:if="{{editorOpen || !records.length}}" class="editor"><picker mode="selector" range="{{roles}}" value="{{roleIndex}}" bindchange="onRoleChange"><view class="picker">职务：{{roles[roleIndex]}}</view></picker><picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="onStudentChange"><view class="picker">学生：{{students[studentIndex].name || '请选择'}}</view></picker><input placeholder="备注（可选）" value="{{remark}}" bindinput="onRemarkInput"/><view class="actions"><button size="mini" bindtap="cancelEdit">取消</button><button type="primary" size="mini" bindtap="save" loading="{{saving}}">保存</button></view></view><view wx:if="{{loading}}" class="state">正在读取班委…</view><view wx:elif="{{error}}" class="state error">{{error}}</view><view wx:elif="{{!records.length}}" class="state">暂无班委，请先选任或一键预设。</view><view wx:else class="record-list"><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text class="role">{{item.role}}</text><text class="name">{{item.studentName}}</text></view><view class="meta">{{item.remark || '未填写备注'}}</view><view class="actions"><button size="mini" data-uuid="{{item.uuid}}" bindtap="edit">编辑</button><button size="mini" data-uuid="{{item.uuid}}" bindtap="remove">解除</button></view></view></view></view>
