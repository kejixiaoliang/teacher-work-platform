@import "../../tokens.wxss";
.page { min-height: 100vh; padding: 28rpx 24rpx 48rpx; box-sizing: border-box; }
.hero { padding: 8rpx 4rpx 24rpx; }.eyebrow { color: var(--tomato); font-size: 20rpx; letter-spacing: 2rpx; font-weight: 700; }.title { margin-top: 10rpx; color: var(--ink); font-size: 48rpx; font-weight: 800; }.subtitle,.panel-note { color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.panel { background: var(--panel); border: 3rpx solid var(--ink); border-radius: 22rpx; box-shadow: 7rpx 7rpx 0 var(--ink); overflow: hidden; }.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx; background: var(--mustard-soft); border-bottom: 2rpx solid var(--line); }.panel-title { font-size: 30rpx; font-weight: 800; }.btn { min-height: 68rpx; padding: 0 22rpx; border: 2rpx solid var(--ink); border-radius: 14rpx; background: var(--panel); color: var(--ink); font-size: 24rpx; font-weight: 700; line-height: 64rpx; }.btn::after { border: 0; }.btn-primary { background: var(--tomato); color: #fff; }.btn-danger { border-color: var(--tomato); color: var(--tomato); }.btn-small { min-height: 52rpx; line-height: 48rpx; padding: 0 12rpx; font-size: 20rpx; }
.editor { margin: 24rpx; padding: 20rpx; border: 2rpx dashed var(--ink); border-radius: 16rpx; background: var(--paper); }.editor-title { font-weight: 800; font-size: 28rpx; margin-bottom: 16rpx; }.field,.input { height: 72rpx; line-height: 72rpx; box-sizing: border-box; border: 2rpx solid var(--ink); border-radius: 12rpx; padding: 0 18rpx; margin-top: 14rpx; background: #fff; color: var(--ink); font-size: 24rpx; }.field text { float: right; color: var(--muted); }.editor-actions { display: flex; gap: 14rpx; margin-top: 16rpx; }.editor-actions .btn { flex: 1; }
.table-head,.table-row { display: grid; grid-template-columns: 1.25fr 1fr .6fr 1fr 1.45fr; gap: 8rpx; align-items: center; padding: 16rpx 20rpx; font-size: 22rpx; }.table-head { background: var(--mustard); font-weight: 800; }.table-row { border-top: 1rpx solid var(--line); min-height: 74rpx; }.role { font-weight: 700; }.row-actions { display: flex; gap: 6rpx; }.empty,.state { padding: 40rpx 24rpx; text-align: center; color: var(--muted); font-size: 24rpx; }.error { color: var(--tomato); }
