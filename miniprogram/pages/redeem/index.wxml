<view class="page"><view class="eyebrow">账号与授权</view><view class="title">兑换码</view><view class="card"><input value="{{code}}" placeholder="请输入兑换码" bindinput="onInput"/><button type="primary" loading="{{loading}}" bindtap="redeem">立即兑换</button><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="section-title">当前授权</view><view wx:if="{{!grants.length}}" class="state">暂无有效授权</view><view wx:for="{{grants}}" wx:key="_id" class="grant"><text>{{item.planType}}</text><text wx:if="{{item.version}}">版本：{{item.version}}</text><text wx:if="{{item.expiresAt}}">有效期至：{{item.expiresAt}}</text></view></view>
