<view class="page"><view class="eyebrow">账号与授权</view><view class="title">兑换码</view><view class="card"><input value="{{code}}" placeholder="请输入兑换码" bindinput="onInput"/><button type="primary" loading="{{loading}}" bindtap="redeem">立即兑换</button><view wx:if="{{error}}" class="error">{{error}}</view><view class="hint">兑换码只提交给受保护的服务端，不会写入本地存储。</view></view><view class="section-row"><text class="section-title">当前授权</text><text class="refresh" bindtap="loadStatus">{{statusLoading ? '读取中…' : '刷新'}}</text></view><view wx:if="{{statusError}}" class="state error">{{statusError}}</view><view wx:if="{{!statusError && !grants.length}}" class="state">暂无有效授权</view><view wx:for="{{grants}}" wx:key="uuid" class="grant"><view class="grant-head"><text>{{item.planType === 'permanent' ? '永久授权' : item.planType === 'annual' ? '年度授权' : '版本授权'}}</text><text class="active">{{item.stateLabel || '有效'}}</text></view><text wx:if="{{item.version}}">版本：{{item.version}}</text><text wx:if="{{item.expiresAt}}">有效期至：{{item.expiresAt}}</text></view><view class="summary">有效 {{summary.active}} · 已过期 {{summary.expired}} · 已撤销 {{summary.revoked}}<text wx:if="{{lastUpdated}}"> · {{lastUpdated}}</text></view><view wx:if="{{history.length > grants.length}}" class="history-title">授权历史</view><view wx:for="{{history}}" wx:if="{{!item.active}}" wx:key="uuid" class="grant grant-history"><view class="grant-head"><text>{{item.planType === 'permanent' ? '永久授权' : item.planType === 'annual' ? '年度授权' : '版本授权'}}</text><text class="inactive">{{item.stateLabel}}</text></view><text wx:if="{{item.version}}">版本：{{item.version}}</text><text wx:if="{{item.expiresAt}}">有效期至：{{item.expiresAt}}</text></view></view>
