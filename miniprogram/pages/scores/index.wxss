@import "../../tokens.wxss";

.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.toolbar,.score-actions{display:flex;justify-content:space-between;align-items:center;gap:10rpx;flex-wrap:wrap}.score-actions{margin-top:14rpx}.picker,.editor input,.score{box-sizing:border-box;margin-top:14rpx;padding:16rpx 18rpx;border:3rpx solid #201b17;border-radius:10rpx;background:#fffdf5;color:#201b17}.picker{width:100%;background:#f2c84b;font-weight:700}.picker.small{width:auto;margin-top:0;padding:10rpx 14rpx}.editor{margin-top:18rpx;padding:20rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#8bd6af;box-shadow:5rpx 5rpx 0 #201b17}.score-list,.trend{margin-top:18rpx}.score-row,.card,.trend-row{display:flex;gap:12rpx;align-items:center;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5;box-shadow:4rpx 4rpx 0 #d9cbb0}.name{width:120rpx;color:#201b17;font-weight:800}.score{width:120rpx;margin-top:0}.score-list button{margin-top:20rpx}.section-title{margin-top:26rpx;color:#201b17;font-weight:800}.error,.state{margin-top:18rpx;padding:20rpx;border:2rpx dashed #201b17;border-radius:12rpx;color:#a8322e}
