.page{padding:40rpx 32rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.toolbar{display:flex;justify-content:space-between;align-items:center}.picker,.editor input,.score{box-sizing:border-box;margin-top:16rpx;padding:18rpx 20rpx;border:1rpx solid #eadfd5;border-radius:14rpx;background:#fffdf9}.picker{width:100%}.editor{margin-top:18rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx}.score-list{margin-top:18rpx}.score-row,.card{display:flex;gap:12rpx;align-items:center;margin-top:14rpx;padding:18rpx;border:1rpx solid #eadfd5;border-radius:14rpx;background:#fffdf9}.name{width:120rpx;color:#1d2939;font-weight:600}.score{width:120rpx;margin-top:0}.score-list button{margin-top:20rpx}.section-title{margin-top:26rpx;color:#1d2939;font-weight:600}.error,.state{margin-top:18rpx;color:#b42318}
