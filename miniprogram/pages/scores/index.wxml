<view class="page"><view class="eyebrow">成绩与分析</view><view class="title">成绩管理</view><view class="toolbar"><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><button size="mini" bindtap="openExam">新建考试</button></view><picker wx:if="{{exams.length}}" mode="selector" range="{{exams}}" range-key="name" bindchange="selectExam"><view class="picker">选择考试</view></picker><view wx:if="{{editingExam}}" class="editor"><input placeholder="考试名称" data-field="name" bindinput="onExamInput"/><input placeholder="日期" data-field="date" value="{{examForm.date}}" bindinput="onExamInput"/><input placeholder="科目，用逗号分隔" data-field="subjects" value="{{examForm.subjects}}" bindinput="onExamInput"/><button type="primary" size="mini" bindtap="saveExam">保存考试</button></view><view wx:if="{{examUuid && rows.length}}" class="score-list"><view wx:for="{{rows}}" wx:for-index="rowIndex" wx:key="studentUuid" class="score-row"><text class="name">{{item.name}}</text><block wx:for="{{subjects}}" wx:for-item="subject" wx:key="*this"><input class="score" type="number" placeholder="{{subject}}" data-row="{{rowIndex}}" data-subject="{{subject}}" value="{{rows[rowIndex].values[subject]}}" bindinput="onScoreInput"/></block></view><button type="primary" loading="{{saving}}" bindtap="saveScores">保存成绩</button><button size="mini" bindtap="loadAnalysis">查看排名与统计</button></view><view wx:if="{{analysis}}" class="analysis"><view class="section-title">科目统计</view><view wx:for="{{analysis.subjects}}" wx:key="subject" class="card">{{item.subject}}：平均 {{item.avg}}，最高 {{item.max}}，及格率 {{item.pass}}%</view><view class="section-title">排名</view><view wx:for="{{analysis.ranking}}" wx:key="studentUuid" class="card">第 {{item.rank}} 名　{{item.studentUuid}}　{{item.total}} 分</view></view><view wx:if="{{error}}" class="state error">{{error}}</view></view>
