<view class="page">
  <view class="eyebrow">成绩与分析</view>
  <view class="title">成绩管理</view>
  <view class="toolbar">
    <picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker>
    <button size="mini" bindtap="openExam">新建考试</button>
  </view>
  <picker wx:if="{{exams.length}}" mode="selector" range="{{exams}}" range-key="name" bindchange="selectExam"><view class="picker">选择考试</view></picker>
  <view wx:if="{{editingExam}}" class="editor"><input placeholder="考试名称" data-field="name" value="{{examForm.name}}" bindinput="onExamInput"/><input placeholder="日期" data-field="date" value="{{examForm.date}}" bindinput="onExamInput"/><input placeholder="科目，用逗号分隔" data-field="subjects" value="{{examForm.subjects}}" bindinput="onExamInput"/><button type="primary" size="mini" bindtap="saveExam">保存考试</button></view>
  <view wx:if="{{examUuid}}" class="file-actions"><button size="mini" bindtap="chooseScoreFile">选择成绩文件</button><button size="mini" bindtap="exportScoreFile">导出成绩 CSV</button><button size="mini" bindtap="copyExport">复制规范 JSON</button></view>
  <view wx:if="{{importPreview}}" class="import-card"><view class="section-title">导入预览 · {{importFileName}}</view><view class="summary">共 {{importPreview.total}} 条，可导入 {{importPreview.rows.length}} 条，失败 {{importPreview.fails.length}} 条</view><view wx:for="{{importPreview.rows}}" wx:key="index" class="preview-row">第 {{item.row}} 行 · {{item.studentName}} · {{item.subject}} {{item.score}} 分</view><view wx:for="{{importPreview.fails}}" wx:key="index" class="preview-row fail">第 {{item.row}} 行 · {{item.name}} · {{item.subject}}：{{item.reason}}</view><view wx:if="{{importApplied}}" class="applied">已填入 {{importApplied}} 条，请点击“保存成绩”持久化。</view><view class="import-actions"><button size="mini" bindtap="cancelScoreImport">取消</button><button type="primary" size="mini" disabled="{{!importPreview.rows.length || importApplied}}" bindtap="confirmScoreImport">应用到录入表</button></view></view>
  <view wx:if="{{examUuid && rows.length}}" class="score-list"><view wx:for="{{rows}}" wx:for-index="rowIndex" wx:key="studentUuid" class="score-row"><text class="name">{{item.name}}</text><block wx:for="{{subjects}}" wx:for-item="subject" wx:key="*this"><input class="score" type="number" placeholder="{{subject}}" data-row="{{rowIndex}}" data-subject="{{subject}}" value="{{rows[rowIndex].values[subject]}}" bindinput="onScoreInput"/></block></view><button type="primary" loading="{{saving}}" bindtap="saveScores">保存成绩</button><button size="mini" bindtap="loadAnalysis">查看排名与统计</button></view>
  <view wx:if="{{analysis}}" class="analysis"><view class="section-title">科目统计</view><view wx:for="{{analysis.subjects}}" wx:key="subject" class="card">{{item.subject}}：平均 {{item.avg}}，最高 {{item.max}}，及格率 {{item.pass}}%</view><view class="section-title">排名</view><view wx:for="{{analysis.ranking}}" wx:key="studentUuid" class="card">第 {{item.rank}} 名　{{item.name || item.studentUuid}}　{{item.total}} 分</view></view>
  <view class="score-actions"><button size="mini" bindtap="editExam">编辑考试</button><button size="mini" bindtap="deleteExam">删除考试</button><button size="mini" bindtap="exportScoreXlsxFile">导出成绩 Excel</button><picker mode="selector" range="{{classStudents}}" range-key="name" bindchange="selectTrendStudent"><view class="picker small">选择学生走势</view></picker><button size="mini" bindtap="loadTrend">查看走势</button></view>
  <view wx:if="{{trend}}" class="trend"><view class="section-title">成绩走势</view><view wx:for="{{trend}}" wx:key="_id" class="trend-row"><text>{{item.examUuid}}</text><text>{{item.subject}}：{{item.score}}</text></view></view>
  <view wx:if="{{error}}" class="state error">{{error}}</view>
</view>
