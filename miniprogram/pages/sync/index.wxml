<view class="page"><view class="eyebrow">DATA / SYNC</view><view class="title">数据同步</view><view class="hint">先检查 CloudBase 当前数据状态；正式同步前必须明确同步方向、冲突处理和本地备份。</view><button type="primary" size="mini" bindtap="checkStatus" loading="{{loading}}">检查云端状态</button><view wx:if="{{error}}" class="state error">{{error}}</view><view wx:if="{{status}}" class="card"><view class="card-title">状态检查结果</view><view class="meta">数据集：{{status.datasetId}}</view><view class="meta">检查时间：{{checkedAt}}</view><view class="notice">{{status.message}}</view><view wx:for="{{status.counts}}" wx:for-item="count" wx:for-index="collection" wx:key="collection" class="count-row"><text>{{collection}}</text><text>{{count}} 条</text></view></view></view>
