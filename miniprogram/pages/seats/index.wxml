<view class="page">
  <view class="eyebrow">常用</view><view class="title">座位管理</view>
  <picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="selectClass"><view class="picker">班级：{{classes[classIndex].name || '请选择班级'}}</view></picker>
  <view class="layout-settings"><view class="number-field"><text>行数</text><input type="number" value="{{rows}}" data-field="rows" bindblur="onLayoutNumber"/></view><view class="number-field"><text>列数</text><input type="number" value="{{cols}}" data-field="cols" bindblur="onLayoutNumber"/></view><picker mode="selector" range="{{aisleLabels}}" value="{{aisleMode}}" bindchange="onAisleChange"><view class="layout-picker">过道：{{aisleLabels[aisleMode]}}（均分 / 中间走道 / 双走道）</view></picker></view>
  <input class="podium-input" data-field="podiumLabel" value="{{podiumLabel}}" maxlength="40" bindinput="onTextInput" placeholder="讲台名称"/><view class="podium">{{podiumLabel || '讲台'}}</view>
  <view class="grid" style="grid-template-columns: repeat({{cols}}, minmax(0, 1fr))"><view wx:for="{{grid}}" wx:key="*this" class="seat {{item.studentUuid ? 'occupied' : 'empty'}} {{item.locked ? 'locked' : ''}} {{item.aisleBefore ? 'aisle-before' : ''}} {{index === selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectSeat"><text>{{item.displayName}}</text><text class="position">{{item.row + 1}}-{{item.col + 1}}</text><text wx:if="{{item.seatNote}}" class="note-dot">需</text></view></view>
  <view wx:if="{{selected !== null}}" class="panel"><picker mode="selector" range="{{students}}" range-key="name" bindchange="chooseStudent"><view class="picker">安排学生：{{selectedStudentName}}</view></picker><view class="seat-note"><text class="note-label">座位备注</text><text>{{selectedSeatNote || '该学生未填写特殊座位需求'}}</text></view><view class="actions"><button size="mini" bindtap="toggleLock">{{grid[selected].locked ? '解锁' : '锁定'}}</button><button size="mini" bindtap="clearSeat">设为空座</button></view></view>
  <view class="quick-actions"><button size="mini" bindtap="autoArrange">自动排座</button><button size="mini" data-dr="1" data-dc="0" bindtap="shift">整体下移</button><button size="mini" data-dr="0" data-dc="1" bindtap="shift">整体右移</button><button size="mini" bindtap="showHistory">历史布局</button></view>
  <view class="auto-options"><text class="options-title">自动排座规则</text><label><switch data-key="nearVision" checked="{{autoOpts.nearVision}}" bindchange="toggleAutoOption"/>近视坐中间</label><label><switch data-key="gender" checked="{{autoOpts.gender}}" bindchange="toggleAutoOption"/>男女搭配</label><label><switch data-key="peerHelp" checked="{{autoOpts.peerHelp}}" bindchange="toggleAutoOption"/>成绩互助</label><text class="rule-help">特殊座位需求支持：前排、后排、中间、靠窗、靠过道。</text></view>
  <view wx:if="{{autoConflicts.length}}" class="conflicts"><text>预览提示：</text><text wx:for="{{autoConflicts}}" wx:key="*this">{{item}}</text></view>
  <textarea class="remark" data-field="layoutRemark" value="{{layoutRemark}}" maxlength="500" bindinput="onTextInput" placeholder="本次布局备注（保存到历史）"/><button type="primary" loading="{{saving}}" bindtap="save">保存布局</button><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{historyVisible}}" class="history"><view class="history-title">历史布局</view><view wx:for="{{history}}" wx:key="savedAt" class="history-row"><view><text>{{item.savedAt}}</text><text class="history-remark">{{item.remark || '无备注'}}</text></view><button size="mini" data-index="{{index}}" bindtap="restoreHistory">恢复</button></view></view>
</view>

