<view class="page"><view class="eyebrow">班级与学生</view><view class="title">座位管理</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="podium">讲台</view><view class="grid" style="grid-template-columns: repeat({{cols}}, 1fr)"><view wx:for="{{grid}}" wx:key="*this" class="seat {{item.studentUuid ? 'occupied' : 'empty'}} {{item.locked ? 'locked' : ''}} {{index === selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectSeat"><text>{{studentName(item.studentUuid)}}</text><text class="position">{{item.row + 1}}-{{item.col + 1}}</text></view></view><view wx:if="{{selected !== null}}" class="panel"><picker mode="selector" range="{{students}}" range-key="name" bindchange="chooseStudent"><view class="picker">安排学生</view></picker><view class="actions"><button size="mini" bindtap="toggleLock">{{grid[selected].locked ? '解锁' : '锁定'}}</button><button size="mini" bindtap="clearSeat">设为空座</button></view></view><button type="primary" loading="{{saving}}" bindtap="save">保存布局</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
