<view class="page"><view class="eyebrow">常用</view><view class="title">座位管理</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><view class="podium">讲台</view><view class="grid" style="grid-template-columns: repeat({{cols}}, 1fr)"><view wx:for="{{grid}}" wx:key="*this" class="seat {{item.studentUuid ? 'occupied' : 'empty'}} {{item.locked ? 'locked' : ''}} {{index === selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectSeat"><text>{{studentName(item.studentUuid)}}</text><text class="position">{{item.row + 1}}-{{item.col + 1}}</text></view></view><view wx:if="{{selected !== null}}" class="panel"><picker mode="selector" range="{{students}}" range-key="name" bindchange="chooseStudent"><view class="picker">安排学生</view></picker><view class="actions"><button size="mini" bindtap="toggleLock">{{grid[selected].locked ? '解锁' : '锁定'}}</button><button size="mini" bindtap="clearSeat">设为空座</button></view></view><button type="primary" loading="{{saving}}" bindtap="save">保存布局</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
<view class="quick-actions"><button size="mini" bindtap="autoArrange">自动排座</button><button size="mini" data-dr="1" data-dc="0" bindtap="shift">整体下移</button><button size="mini" data-dr="0" data-dc="1" bindtap="shift">整体右移</button><button size="mini" bindtap="showHistory">历史布局</button></view>
<view class="auto-options"><text class="options-title">自动排座规则</text><label><switch data-key="nearVision" checked="{{autoOpts.nearVision}}" bindchange="toggleAutoOption" />近视坐中间</label><label><switch data-key="gender" checked="{{autoOpts.gender}}" bindchange="toggleAutoOption" />男女搭配</label><label><switch data-key="peerHelp" checked="{{autoOpts.peerHelp}}" bindchange="toggleAutoOption" />成绩互助</label></view><view wx:if="{{autoConflicts.length}}" class="conflicts"><text>预览提示：</text><text wx:for="{{autoConflicts}}" wx:key="*this">{{item}}</text></view>
<view wx:if="{{historyVisible}}" class="history"><view class="history-title">历史布局</view><view wx:for="{{history}}" wx:key="savedAt" class="history-row"><text>{{item.savedAt}}</text><button size="mini" data-index="{{index}}" bindtap="restoreHistory">恢复</button></view></view>

