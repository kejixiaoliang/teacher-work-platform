.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.picker{padding:18rpx 20rpx;border:1rpx solid #eadfd5;border-radius:14rpx;background:#fffdf9;color:#475467}.podium{width:40%;margin:28rpx auto 20rpx;padding:12rpx;text-align:center;border-radius:999rpx;background:#fef0c7;color:#93370d}.grid{display:grid;gap:10rpx}.seat{min-height:100rpx;padding:12rpx 4rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;border:1rpx solid #eadfd5;border-radius:14rpx;background:#fffdf9;font-size:22rpx;text-align:center}.seat.empty{border-style:dashed;color:#98a2b3}.seat.occupied{background:#e7f8f3;color:#1d2939}.seat.locked{border:3rpx solid #f79009}.seat.selected{outline:4rpx solid #b54708}.position{margin-top:6rpx;color:#98a2b3;font-size:18rpx}.panel{margin-top:24rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.actions{display:flex;gap:14rpx;margin-top:16rpx}.page>button{margin-top:24rpx}.error{margin-top:18rpx;color:#b42318}
