@import "../../tokens.wxss";

.auto-options{margin-top:22rpx;padding:18rpx;border:2rpx solid #d9cbb0;border-radius:12rpx;background:#fffdf5}.options-title{display:block;margin-bottom:12rpx;color:#d64541;font-weight:700}.auto-options label{display:flex;align-items:center;margin:10rpx 0;color:#51463d;font-size:24rpx}.auto-options switch{margin-right:10rpx}.conflicts{margin-top:14rpx;padding:14rpx;border:2rpx dashed #d64541;border-radius:10rpx;color:#a8322e;font-size:22rpx}.conflicts text{display:block;margin:4rpx 0}

.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker{padding:16rpx 18rpx;border:3rpx solid #201b17;border-radius:10rpx;background:#f2c84b;color:#201b17;font-weight:700}.layout-settings{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:16rpx}.number-field,.layout-picker,.podium-input,.remark{box-sizing:border-box;padding:14rpx 16rpx;border:2rpx solid #201b17;border-radius:10rpx;background:#fffdf5;font-size:22rpx}.number-field{display:flex;align-items:center;gap:10rpx}.number-field input{width:90rpx;text-align:center}.layout-settings picker{grid-column:1/3}.podium-input{width:100%;height:68rpx;margin-top:14rpx}.podium{width:40%;margin:18rpx auto;padding:12rpx;text-align:center;border:3rpx solid #201b17;border-radius:999rpx;background:#f2c84b;color:#201b17;font-weight:800}.grid{display:grid;gap:10rpx}.seat{position:relative;min-height:100rpx;padding:12rpx 4rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;border:3rpx solid #201b17;border-radius:12rpx;background:#fffdf5;font-size:22rpx;text-align:center;box-shadow:3rpx 3rpx 0 #d9cbb0}.seat.aisle-before{margin-left:24rpx}.seat.empty{border-style:dashed;color:#8a7d70}.seat.occupied{background:#8bd6af;color:#201b17}.seat.locked{border:3rpx solid #d64541;background:#f9d8ca}.seat.selected{outline:4rpx solid #d64541}.position{margin-top:6rpx;color:#75695e;font-size:18rpx}.note-dot{position:absolute;right:-6rpx;top:-8rpx;width:32rpx;height:32rpx;border-radius:50%;background:#d64541;color:#fff;font-size:18rpx;line-height:32rpx}.panel{margin-top:24rpx;padding:20rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#fffdf5;box-shadow:5rpx 5rpx 0 #201b17}.seat-note{display:flex;flex-direction:column;gap:6rpx;margin-top:14rpx;color:#51463d;font-size:22rpx}.note-label{font-weight:800}.actions{display:flex;gap:14rpx;margin-top:16rpx}.quick-actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:22rpx}.rule-help{display:block;margin-top:12rpx;color:#75695e;font-size:21rpx}.remark{width:100%;height:110rpx;margin-top:18rpx}.page>button{margin-top:24rpx}.error{margin-top:18rpx;padding:18rpx;border:2rpx dashed #d64541;color:#a8322e}.history{margin-top:20rpx;padding:16rpx;border:2rpx solid #201b17;border-radius:12rpx;background:#fffdf5}.history-title{font-weight:900}.history-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:12rpx 0;border-bottom:1rpx solid #d9cbb0;font-size:21rpx}.history-remark{display:block;color:#75695e}
