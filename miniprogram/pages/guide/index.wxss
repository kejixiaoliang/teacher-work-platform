@import "../../tokens.wxss";.page{min-height:100vh;padding:28rpx 24rpx 48rpx}.eyebrow{color:var(--tomato);font-size:20rpx;font-weight:800;letter-spacing:2rpx}.title{margin:10rpx 0;font-size:48rpx;font-weight:900}.subtitle,.step-text,.module-text{color:var(--muted);font-size:24rpx;line-height:1.6}.section-title{margin:34rpx 0 14rpx;font-size:30rpx;font-weight:900}.steps,.module-grid{display:grid;gap:12rpx}.step{display:flex;gap:16rpx;padding:18rpx;border:2rpx solid var(--ink);border-radius:14rpx;background:var(--panel);box-shadow:3rpx 3rpx 0 var(--ink)}.step-no{color:var(--tomato);font-size:24rpx;font-weight:900}.step-title,.step-text,.module-title,.module-text{display:block}.step-title,.module-title{font-size:26rpx;font-weight:900}.step-text,.module-text{margin-top:6rpx}.module-grid{grid-template-columns:repeat(2,1fr)}.module{padding:18rpx;border:2rpx solid var(--line);border-radius:14rpx;background:#fffdf4}.notice{margin-top:24rpx;padding:18rpx;border-left:6rpx solid var(--tomato);background:var(--mustard-soft);color:var(--muted);font-size:22rpx;line-height:1.6}
