<view class="page tw-page"><view class="hero"><view class="eyebrow">SYSTEM / CLASS SETTINGS</view><view class="title">班级设置</view><view class="subtitle">新建、编辑和切换班级，设置学年、学期与座位网格。</view></view><view wx:if="{{error}}" class="state error">{{error}}</view><view class="toolbar"><button class="btn btn-primary" bindtap="openCreate">新建班级</button></view><view wx:if="{{editingUuid || !records.length}}" class="editor"><view class="editor-title">{{editingUuid ? '编辑班级' : '新建班级'}}</view><input class="input" data-field="name" value="{{form.name}}" bindinput="onInput" placeholder="班级名称"/><input class="input" data-field="academicYear" value="{{form.academicYear}}" bindinput="onInput" placeholder="学年，例如 2025"/><picker mode="selector" range="{{['上','下']}}" bindchange="onTermChange"><view class="field">学期：{{form.term}} <text>⌄</text></view></picker><view class="number-row"><input class="input" type="number" data-field="seatRows" value="{{form.seatRows}}" bindinput="onNumber" placeholder="座位行数"/><input class="input" type="number" data-field="seatCols" value="{{form.seatCols}}" bindinput="onNumber" placeholder="座位列数"/></view><input class="input" data-field="headTeacher" value="{{form.headTeacher}}" bindinput="onInput" placeholder="班主任（可选）"/><textarea class="input textarea" data-field="remark" value="{{form.remark}}" bindinput="onInput" placeholder="备注（可选）"/><view class="actions"><button class="btn" bindtap="cancel">取消</button><button class="btn btn-primary" bindtap="save" loading="{{saving}}">保存</button></view></view><view wx:if="{{loading}}" class="state">正在读取班级…</view><view wx:elif="{{!records.length && !editingUuid}}" class="empty">暂无班级，请先新建或导入数据。</view><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text class="record-name">{{item.name}}</text><text class="badge">{{item.academicYear || '未设置'}} · {{item.term || '未设置'}}</text></view><view class="meta">座位 {{item.seatRows || item.seat_rows || '—'}} 行 × {{item.seatCols || item.seat_cols || '—'}} 列 · 班主任 {{item.headTeacher || '未填写'}}</view><view class="actions"><button class="btn btn-small" data-uuid="{{item.uuid}}" bindtap="edit">编辑</button><button class="btn btn-small btn-danger" data-uuid="{{item.uuid}}" bindtap="remove">删除</button></view></view></view>
