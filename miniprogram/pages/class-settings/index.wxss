@import "../../tokens.wxss";
.page{min-height:100vh;padding:28rpx 24rpx 48rpx}.hero{padding:8rpx 4rpx 22rpx}.eyebrow{color:var(--tomato);font-size:20rpx;font-weight:800;letter-spacing:2rpx}.title{margin-top:10rpx;font-size:48rpx;font-weight:900}.subtitle,.meta{color:var(--muted);font-size:24rpx;line-height:1.5}.toolbar{display:flex;justify-content:flex-end;margin-bottom:20rpx}.btn{min-height:62rpx;padding:0 20rpx;border:2rpx solid var(--ink);border-radius:14rpx;background:#fff;color:var(--ink);font-size:23rpx;font-weight:800;line-height:58rpx}.btn::after{border:0}.btn-primary{background:var(--tomato);color:#fff}.btn-danger{border-color:var(--tomato);color:var(--tomato)}.btn-small{min-height:52rpx;line-height:48rpx;padding:0 14rpx;font-size:20rpx}.editor,.record{margin-top:16rpx;padding:20rpx;border:2rpx solid var(--ink);border-radius:16rpx;background:var(--panel);box-shadow:4rpx 4rpx 0 var(--ink)}.editor{background:var(--mustard-soft)}.editor-title{font-size:28rpx;font-weight:900}.input,.field{box-sizing:border-box;width:100%;height:70rpx;margin-top:12rpx;padding:0 16rpx;border:2rpx solid var(--ink);border-radius:12rpx;background:#fff;font-size:23rpx;line-height:70rpx}.textarea{height:110rpx;line-height:1.5;padding-top:14rpx}.field text{float:right;color:var(--muted)}.number-row{display:flex;gap:12rpx}.number-row .input{flex:1}.actions{display:flex;justify-content:flex-end;gap:10rpx;margin-top:14rpx}.record-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.record-name{font-size:28rpx;font-weight:900}.badge{padding:6rpx 10rpx;border:2rpx solid var(--ink);border-radius:999rpx;background:var(--mint);font-size:19rpx}.meta{margin-top:12rpx}.state,.empty{padding:36rpx 20rpx;text-align:center;color:var(--muted);font-size:24rpx}.error{color:var(--tomato)}
