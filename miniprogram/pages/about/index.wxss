@import "../../tokens.wxss";
.page{min-height:100vh;padding:38rpx 26rpx 72rpx}.eyebrow{color:#c65a32;font-size:21rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 22rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:50rpx;font-weight:900}.hero{display:flex;align-items:center;gap:20rpx;padding:22rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#f2c84b;box-shadow:5rpx 5rpx 0 #201b17}.mark{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border:3rpx solid #201b17;border-radius:50%;background:#fffdf5;font-size:30rpx;font-weight:900}.hero-copy text{display:block}.product{font-size:34rpx;font-weight:900}.version{margin-top:8rpx;color:#5f554b;font-size:21rpx}.card{margin-top:18rpx;padding:22rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#fffdf5;box-shadow:4rpx 4rpx 0 #d9cbb0}.maker-card{background:#8bd6af}.license-card{background:#93c9d8}.section-title,.maker,.body,.url{display:block}.section-title{font-size:26rpx;font-weight:900}.maker{margin-top:12rpx;font-size:32rpx;font-weight:900}.body{margin-top:10rpx;color:#5f554b;font-size:24rpx;line-height:1.75}.card button{margin:18rpx 0 0 0;border:2rpx solid #201b17;background:#fffdf5;color:#201b17}.url{margin-top:12rpx;color:#685f55;font-size:19rpx;word-break:break-all}.privacy-row{display:grid;grid-template-columns:42rpx 1fr;gap:10rpx;margin-top:14rpx}.privacy-row .body{margin-top:0}.dot{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border:2rpx solid #201b17;border-radius:50%;background:#f2c84b;font-size:19rpx;font-weight:800}
