@import "../../tokens.wxss";
.page{min-height:100vh;padding:40rpx 28rpx 70rpx}.eyebrow{color:#c65a32;font-size:21rpx;font-weight:700;letter-spacing:3rpx}.title{margin:10rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.card{margin-top:18rpx;padding:24rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#fffdf5;box-shadow:4rpx 4rpx 0 #d9cbb0}.warning{background:#f2c84b}.section-title{display:block;font-size:27rpx;font-weight:900}.body{display:block;margin-top:12rpx;color:#5f554b;font-size:24rpx;line-height:1.7}.card button{margin-top:18rpx}.success{background:#e5f4e9}.meta{display:block;margin-top:12rpx;color:#75695e;font-size:21rpx}.error{margin-top:18rpx;color:#a8322e;font-size:24rpx}

