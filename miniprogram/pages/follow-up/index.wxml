<view class="page">
  <view class="eyebrow">概览首页 / 跟进事项</view>
  <view class="title">跟进事项</view>
  <view class="toolbar"><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">选择班级</view></picker><button wx:if="{{classUuid}}" size="mini" bindtap="openCreate">新建事项</button></view>
  <view wx:if="{{editing}}" class="editor">
    <picker mode="selector" range="{{students}}" range-key="name" data-field="studentUuid" bindchange="onPickerChange"><view class="picker">选择学生</view></picker>
    <input placeholder="标题" data-field="title" value="{{form.title}}" bindinput="onInput" />
    <textarea placeholder="跟进内容" data-field="content" value="{{form.content}}" bindinput="onInput" />
    <picker mode="date" value="{{form.dueDate}}" data-field="dueDate" bindchange="onInput"><view class="picker">截止：{{form.dueDate || '未设置'}}</view></picker>
    <view class="actions"><button size="mini" bindtap="cancelEdit">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="save">保存</button></view>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取跟进事项…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{!records.length}}" class="state">暂无跟进事项</view>
  <view wx:else class="record-list"><view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text class="name">{{studentName(item.studentUuid)}}</text><text class="status">{{item.status}}</text></view><view class="title-small">{{item.title}}</view><view wx:if="{{item.content}}" class="meta">{{item.content}}</view><view wx:if="{{item.dueDate}}" class="meta">截止：{{item.dueDate}}</view><button wx:if="{{item.status !== 'completed' && item.status !== 'cancelled'}}" size="mini" data-uuid="{{item.uuid}}" bindtap="complete">标记完成</button></view></view>
</view>

