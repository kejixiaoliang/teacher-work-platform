@import "../../tokens.wxss";
.page{min-height:100vh;padding:40rpx 28rpx calc(96rpx + env(safe-area-inset-bottom));box-sizing:border-box}.topline{display:flex;align-items:center;justify-content:space-between}.eyebrow{color:#d64541;font-size:20rpx;font-weight:900;letter-spacing:3rpx}.status-dot{color:#685f55;font-size:22rpx}.title{margin:14rpx 0 12rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:52rpx;font-weight:900;line-height:1.18}.lead{display:block;color:#685f55;font-size:26rpx;line-height:1.65}.card{box-sizing:border-box;margin-top:20rpx;padding:24rpx;border:2rpx solid #d9cbb0;border-radius:18rpx;background:#fff9ea;box-shadow:5rpx 5rpx 0 #201b17}.identity-card{background:#fff9ea}.status-mark{display:inline-flex;padding:6rpx 10rpx;border:2rpx solid #201b17;border-radius:999rpx;background:#8bd6af;color:#201b17;font-size:18rpx;font-weight:900;letter-spacing:1rpx}.status-title{display:block;margin-top:10rpx;color:#087443;font-size:30rpx;font-weight:900}.body{display:block;margin-top:12rpx;color:#5f554b;font-size:24rpx;line-height:1.7}.meta{display:block;margin-top:16rpx;color:#75695e;font-size:21rpx}.card button{margin-top:20rpx}.tw-button-primary{border:3rpx solid #201b17;border-radius:16rpx;background:#d64541;color:#fff;font-weight:900}.tw-button-primary::after{border:0}.hint-card{background:#f2c84b}.section-title{display:block;font-size:27rpx;font-weight:900}.state{color:#75695e}.error{padding:20rpx;border:2rpx solid #b85450;border-radius:14rpx;color:#9f3f3b;background:#fff0eb}
