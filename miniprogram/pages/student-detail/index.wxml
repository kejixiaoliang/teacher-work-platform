<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取学生详情…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <block wx:elif="{{student}}">
    <view class="eyebrow">学生档案</view>
    <view class="title">{{student.name || '未命名学生'}}</view>
    <view wx:if="{{editing}}" class="editor">
      <input placeholder="姓名（必填）" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
      <input placeholder="学号" value="{{form.schoolNo}}" data-field="schoolNo" bindinput="onFormInput" />
      <input placeholder="性别" value="{{form.gender}}" data-field="gender" bindinput="onFormInput" />
      <input placeholder="出生日期" value="{{form.birthDate}}" data-field="birthDate" bindinput="onFormInput" />
      <input placeholder="联系电话" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
      <input placeholder="家长电话" value="{{form.parentPhone}}" data-field="parentPhone" bindinput="onFormInput" />
      <input placeholder="身高（cm）" value="{{form.heightCm}}" data-field="heightCm" bindinput="onFormInput" />
      <input placeholder="左眼视力" value="{{form.visionLeft}}" data-field="visionLeft" bindinput="onFormInput" />
      <input placeholder="右眼视力" value="{{form.visionRight}}" data-field="visionRight" bindinput="onFormInput" />
      <input placeholder="健康状况/过敏史" value="{{form.healthNote}}" data-field="healthNote" bindinput="onFormInput" />
      <input placeholder="兴趣特长/职务" value="{{form.interestDuty}}" data-field="interestDuty" bindinput="onFormInput" />
      <textarea placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" />
      <view class="actions"><button size="mini" bindtap="cancelEdit">取消</button><button type="primary" size="mini" loading="{{loading}}" bindtap="saveStudent">保存</button></view>
    </view>
    <view wx:else class="profile">
      <view class="field"><text class="label">学号</text><text>{{student.schoolNo || student.school_no || '—'}}</text></view>
      <view class="field"><text class="label">性别</text><text>{{student.gender || '—'}}</text></view>
      <view class="field"><text class="label">联系电话</text><text>{{student.phone || '—'}}</text></view>
      <view class="field"><text class="label">家长电话</text><text>{{student.parentPhone || student.parent_phone || '—'}}</text></view>
      <view class="field"><text class="label">备注</text><text>{{student.remark || '—'}}</text></view>
    </view>
    <view wx:if="{{!editing}}" class="actions"><button size="mini" bindtap="startEdit">编辑</button><button size="mini" type="warn" bindtap="deleteStudent">移入回收站</button></view>
    <view class="section-title">健康与体征历史</view>
    <view class="actions"><button size="mini" data-type="metric" bindtap="openProfile">记录测量</button></view>
    <view wx:if="{{profileEditing && profileType === 'metric'}}" class="editor"><input placeholder="日期" value="{{profileForm.date}}" data-field="date" bindinput="onProfileInput"/><input placeholder="身高（cm）" value="{{profileForm.height_cm}}" data-field="height_cm" bindinput="onProfileInput"/><input placeholder="左眼视力" value="{{profileForm.vision_left}}" data-field="vision_left" bindinput="onProfileInput"/><input placeholder="右眼视力" value="{{profileForm.vision_right}}" data-field="vision_right" bindinput="onProfileInput"/><view class="switch-line"><text>是否近视</text><switch checked="{{profileForm.is_myopia}}" bindchange="onMyopiaChange" /></view><view class="actions"><button size="mini" bindtap="cancelProfile">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="saveProfile">保存测量</button></view></view>
    <view wx:if="{{!metrics.length}}" class="state compact">暂无体征历史</view>
    <view wx:for="{{metrics}}" wx:key="uuid" class="record"><view class="record-head"><text>{{item.date || '未填写日期'}}</text><text>{{item.height_cm || '—'}}cm</text></view><view class="meta">视力 {{item.vision_left || '—'}} / {{item.vision_right || '—'}} · 近视 {{item.is_myopia ? '是' : '否'}}</view><button size="mini" data-type="metric" data-uuid="{{item.uuid}}" bindtap="removeProfile">删除</button></view>
    <view class="section-title">成长档案</view>
    <view class="actions"><button size="mini" data-type="record" bindtap="openProfile">添加记录</button></view>
    <view wx:if="{{profileEditing && profileType === 'record'}}" class="editor"><input placeholder="类型（奖励/批评/评语/表现）" value="{{profileForm.type}}" data-field="type" bindinput="onProfileInput"/><input placeholder="日期" value="{{profileForm.date}}" data-field="date" bindinput="onProfileInput"/><textarea placeholder="记录内容" value="{{profileForm.content}}" data-field="content" bindinput="onProfileInput"/><textarea placeholder="备注" value="{{profileForm.remark}}" data-field="remark" bindinput="onProfileInput"/><view class="actions"><button size="mini" bindtap="cancelProfile">取消</button><button type="primary" size="mini" loading="{{saving}}" bindtap="saveProfile">保存记录</button></view></view>
    <view wx:if="{{!records.length}}" class="state compact">暂无成长记录</view>
    <view wx:for="{{records}}" wx:key="uuid" class="record"><view class="record-head"><text>{{item.type || '记录'}}</text><text>{{item.date || '未填写日期'}}</text></view><view class="content">{{item.content}}</view><view class="meta">{{item.remark || '无备注'}}</view><button size="mini" data-type="record" data-uuid="{{item.uuid}}" bindtap="openProfile">编辑</button><button size="mini" data-type="record" data-uuid="{{item.uuid}}" bindtap="removeProfile">删除</button></view>
    <view class="section-title">关联业务记录</view>
    <view class="actions"><button size="mini" bindtap="openFollowUps">跟进事项（{{followUpTasks.length}}）</button><button size="mini" bindtap="openContacts">家校沟通（{{contacts.length}}）</button></view>
  </block>
</view>
