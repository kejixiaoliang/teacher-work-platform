<view class="page">
  <view class="eyebrow">班级资料</view>
  <view class="title">学生管理</view>
  <view class="toolbar"><button wx:if="{{datasetId && !trashed}}" class="create-button" size="mini" bindtap="openCreate">新增学生</button><button wx:if="{{datasetId && !trashed}}" size="mini" bindtap="chooseImportFile">导入名单</button><button wx:if="{{datasetId && !trashed}}" size="mini" bindtap="toggleImportHistory">{{historyVisible ? '收起历史' : '导入历史'}}</button><button wx:if="{{datasetId && !trashed}}" size="mini" bindtap="exportStudents">复制名单 JSON</button><button size="mini" bindtap="toggleTrash">{{trashed ? '返回学生列表' : '回收站'}}</button></view>
  <picker wx:if="{{classes.length}}" range="{{classes}}" range-key="name" bindchange="onClassChange"><view class="class-picker">当前班级：{{currentClassName}}</view></picker>
  <input class="search" placeholder="搜索姓名或学号" value="{{keyword}}" bindinput="onKeywordInput" />
  <view wx:if="{{importPreview}}" class="import-panel">
    <view class="editor-title">学生名单导入预览</view>
    <view class="import-file">{{importFileName}} · {{importPreview.format === 'csv' ? 'CSV' : '规范 JSON'}}</view>
    <view class="import-hint">已按桌面端 16 个学生字段自动映射到当前班级。</view>
    <view class="import-counts"><text>总行数 {{importPreview.total}}</text><text>可导入 {{importPreview.rows.length}}</text><text>预检失败 {{importPreview.fails.length}}</text></view>
    <view wx:if="{{importPreview.fails.length}}" class="failure-list">
      <view wx:for="{{importPreview.fails}}" wx:key="row" class="failure-item">第 {{item.row}} 行{{item.name ? '「' + item.name + '」' : ''}}：{{item.reason}}</view>
    </view>
    <view wx:if="{{importResult}}" class="import-result">
      <view>导入完成：成功 {{importResult.counts.success}} 人，失败 {{importResult.counts.failed}} 人</view>
      <view wx:for="{{importResult.fail}}" wx:key="row" class="failure-item">第 {{item.row}} 行{{item.name ? '「' + item.name + '」' : ''}}：{{item.reason}}</view>
    </view>
    <view class="editor-actions"><button size="mini" bindtap="cancelStudentImport">关闭</button><button wx:if="{{!importResult}}" type="primary" size="mini" loading="{{loading}}" disabled="{{!importPreview.rows.length}}" bindtap="confirmStudentImport">确认导入当前班级</button></view>
  </view>
  <view wx:if="{{historyVisible}}" class="import-history">
    <view class="editor-title">当前班级导入历史</view>
    <view wx:if="{{historyLoading}}" class="history-state">正在读取导入历史…</view>
    <view wx:elif="{{historyError}}" class="history-state error">{{historyError}}<button size="mini" bindtap="loadImportHistory">重试</button></view>
    <view wx:elif="{{!importHistory.length}}" class="history-state">暂无学生名单导入记录</view>
    <view wx:else class="history-list">
      <view wx:for="{{importHistory}}" wx:key="importBatchId" class="history-item">
        <view class="history-head"><text>{{item.fileName}}</text><text>{{item.createdAtText}}</text></view>
        <view class="history-summary">{{item.fileFormat === 'csv' ? 'CSV' : item.fileFormat === 'json' ? '规范 JSON' : '未知格式'}} · 总计 {{item.totalCount}} · 成功 {{item.successCount}} · 失败 {{item.failedCount}}</view>
        <view wx:if="{{item.failures.length}}" class="history-failures"><view wx:for="{{item.failures}}" wx:for-item="failure" wx:key="row" class="failure-item">第 {{failure.row}} 行{{failure.name ? '「' + failure.name + '」' : ''}}：{{failure.reason}}</view></view>
      </view>
    </view>
  </view>
  <view class="filter-grid">
    <picker range="{{filterOptions.gender}}" data-field="gender" bindchange="onFilterChange"><view class="filter-picker">{{filters.gender || '全部性别'}}</view></picker>
    <picker range="{{filterOptions.status}}" data-field="status" bindchange="onFilterChange"><view class="filter-picker">{{filters.status || '全部状态'}}</view></picker>
    <picker range="{{filterOptions.myopia}}" data-field="myopia" bindchange="onFilterChange"><view class="filter-picker">{{filters.myopia === 'yes' ? '近视：是' : filters.myopia === 'no' ? '近视：否' : '全部近视'}}</view></picker>
    <picker range="{{filterOptions.boarding}}" data-field="boarding" bindchange="onFilterChange"><view class="filter-picker">{{filters.boarding === 'yes' ? '住宿：是' : filters.boarding === 'no' ? '住宿：否' : '全部住宿'}}</view></picker>
    <picker range="{{filterOptions.followUpStatus}}" data-field="followUpStatus" bindchange="onFilterChange"><view class="filter-picker">{{filters.followUpStatus || '全部跟进'}}</view></picker>
    <button size="mini" bindtap="clearFilters">清除筛选</button>
  </view>

  <view wx:if="{{editing}}" class="editor">
    <view class="editor-title">新增学生</view>
    <input placeholder="姓名（必填）" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
    <input placeholder="学号" value="{{form.schoolNo}}" data-field="schoolNo" bindinput="onFormInput" />
    <input placeholder="性别" value="{{form.gender}}" data-field="gender" bindinput="onFormInput" />
    <input placeholder="联系电话" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
    <input placeholder="家长电话" value="{{form.parentPhone}}" data-field="parentPhone" bindinput="onFormInput" />
    <picker range="{{['男','女']}}" data-field="gender" bindchange="onFormPickerChange"><view class="picker">性别：{{form.gender || '未设置'}}</view></picker>
    <picker mode="date" value="{{form.birthDate}}" data-field="birthDate" bindchange="onFormInput"><view class="picker">出生日期：{{form.birthDate || '未设置'}}</view></picker>
    <picker range="{{['在读','转出','休学']}}" data-field="status" bindchange="onFormPickerChange"><view class="picker">状态：{{form.status}}</view></picker>
    <picker range="{{['正常','需关注','跟进中','已处理']}}" data-field="followUpStatus" bindchange="onFormPickerChange"><view class="picker">跟进：{{form.followUpStatus}}</view></picker>
    <input placeholder="身高(cm)" value="{{form.heightCm}}" data-field="heightCm" bindinput="onFormInput" />
    <input placeholder="左眼视力" value="{{form.visionLeft}}" data-field="visionLeft" bindinput="onFormInput" />
    <input placeholder="右眼视力" value="{{form.visionRight}}" data-field="visionRight" bindinput="onFormInput" />
    <input placeholder="兴趣特长/职务" value="{{form.interestDuty}}" data-field="interestDuty" bindinput="onFormInput" />
    <input placeholder="特殊座位需求" value="{{form.seatNote}}" data-field="seatNote" bindinput="onFormInput" />
    <input placeholder="健康状况" value="{{form.healthNote}}" data-field="healthNote" bindinput="onFormInput" />
    <view class="switch-line"><text>是否近视</text><switch checked="{{form.isMyopia}}" data-field="isMyopia" bindchange="onFormSwitch" /></view>
    <view class="switch-line"><text>是否住宿</text><switch checked="{{form.isBoarding}}" data-field="isBoarding" bindchange="onFormSwitch" /></view>
    <textarea placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" />
    <view class="editor-actions"><button size="mini" bindtap="cancelEdit">取消</button><button type="primary" size="mini" loading="{{loading}}" bindtap="saveStudent">保存</button></view>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取学生数据…</view>
  <view wx:elif="{{error}}" class="state error">
    <view>{{error}}</view>
    <button wx:if="{{datasetId}}" size="mini" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!visibleStudents.length}}" class="state">{{trashed ? '回收站为空' : '暂无匹配的学生'}}</view>
  <view wx:else class="student-list">
    <checkbox-group bindchange="onSelectionChange"><view wx:for="{{visibleStudents}}" wx:key="uuid" class="student-row" data-uuid="{{item.uuid}}" bindtap="openDetail">
      <checkbox value="{{item.uuid}}" catchtap="noop" />
      <view class="student-main">
        <view class="student-name">{{item.name || '未命名学生'}}</view>
        <view wx:if="{{item.schoolNo || item.school_no}}" class="school-no">学号：{{item.schoolNo || item.school_no}}</view>
      </view>
      <button wx:if="{{!trashed}}" size="mini" class="danger-button" data-uuid="{{item.uuid}}" catchtap="deleteStudent">删除</button><text wx:else class="chevron">已删除</text>
    </view></checkbox-group>
    <view wx:if="{{trashed}}" class="trash-actions"><button size="mini" bindtap="restoreSelected">恢复选中</button><button size="mini" class="danger-button" bindtap="purgeSelected">彻底删除</button></view>
  </view>
</view>
