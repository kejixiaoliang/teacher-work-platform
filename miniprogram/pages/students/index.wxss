@import "../../tokens.wxss";

.page { padding: 34rpx 32rpx 64rpx; }
.eyebrow { color: #b54708; font-size: 24rpx; letter-spacing: 2rpx; }
.title { margin-top: 10rpx; color: #1d2939; font-size: 48rpx; font-weight: 700; }
.create-button { margin: 20rpx 0 0; margin-left: 0; }
.toolbar { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.toolbar button { margin: 0; }
.class-picker { margin-top: 16rpx; padding: 16rpx 18rpx; border: 2rpx solid #201b17; border-radius: 10rpx; background: #fffdf5; color: #201b17; }
.search { box-sizing: border-box; height: 84rpx; margin-top: 28rpx; padding: 0 24rpx; border: 1rpx solid #eadfd5; border-radius: 16rpx; background: #fffdf9; color: #344054; }
.editor { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #eadfd5; border-radius: 18rpx; background: #fffdf9; }
.import-panel { margin-top: 24rpx; padding: 24rpx; border: 3rpx solid #201b17; border-radius: 14rpx; background: #fff3bf; box-shadow: 5rpx 5rpx 0 #201b17; }
.import-file { color: #201b17; font-weight: 700; }
.import-hint { margin-top: 10rpx; color: #5f554b; font-size: 24rpx; line-height: 1.6; }
.import-counts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.import-counts text { padding: 8rpx 12rpx; border: 2rpx solid #201b17; border-radius: 999rpx; background: #fffdf5; font-size: 23rpx; }
.failure-list, .import-result { margin-top: 18rpx; padding: 16rpx; border: 2rpx solid #d64541; border-radius: 10rpx; background: #fffdf5; }
.failure-item { margin-top: 8rpx; color: #a8322e; font-size: 23rpx; line-height: 1.55; }
.failure-item:first-child { margin-top: 0; }
.editor-title { margin-bottom: 18rpx; color: #344054; font-size: 30rpx; font-weight: 600; }
.editor input, .editor textarea { box-sizing: border-box; width: 100%; margin-top: 16rpx; padding: 18rpx; border: 1rpx solid #eadfd5; border-radius: 12rpx; background: #ffffff; }
.editor textarea { min-height: 120rpx; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.state { margin-top: 28rpx; color: #667085; line-height: 1.6; }
.error { color: #b42318; }
.student-list { margin-top: 28rpx; overflow: hidden; border: 1rpx solid #eadfd5; border-radius: 18rpx; background: #fffdf9; }
.student-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0e8df; }
.student-main { flex: 1; margin-left: 14rpx; }
.danger-button { border: 2rpx solid #d64541 !important; color: #d64541 !important; background: #fffdf5 !important; }
.trash-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.trash-actions button { margin: 0; }
.student-row:last-child { border-bottom: 0; }
.student-name { color: #1d2939; font-size: 32rpx; font-weight: 600; }
.school-no { margin-top: 8rpx; color: #667085; font-size: 25rpx; }
.chevron { color: #98a2b3; font-size: 38rpx; line-height: 1; }

.eyebrow { color: #d64541; font-weight: 700; letter-spacing: 3rpx; }
.title { color: #201b17; font-family: "Noto Serif SC", "Songti SC", serif; font-weight: 900; }
.create-button { border: 3rpx solid #201b17; border-radius: 12rpx; background: #f2c84b; box-shadow: 4rpx 4rpx 0 #201b17; color: #201b17; font-weight: 700; }
.search { border: 3rpx solid #201b17; border-radius: 12rpx; background: #fffdf5; color: #201b17; }
.filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 16rpx; }
.filter-picker { padding: 16rpx 18rpx; border: 2rpx solid #201b17; border-radius: 10rpx; background: #fffdf5; color: #5f554b; font-size: 24rpx; }
.filter-grid button { margin: 0; padding: 0 14rpx; border: 2rpx solid #201b17; border-radius: 10rpx; background: #f2c84b; color: #201b17; font-size: 24rpx; line-height: 2.2; }
.switch-line { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 4rpx 8rpx; color: #5f554b; }
.editor { border: 3rpx solid #201b17; border-radius: 14rpx; background: #8bd6af; box-shadow: 5rpx 5rpx 0 #201b17; }
.editor input, .editor textarea { border: 2rpx solid #201b17; border-radius: 10rpx; background: #fffdf5; }
.state { padding: 22rpx; border: 2rpx dashed #201b17; border-radius: 12rpx; color: #5f554b; }
.error { border-color: #d64541; color: #a8322e; }
.student-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; border: 0; background: transparent; }
.student-row { min-height: 126rpx; box-sizing: border-box; padding: 20rpx; border: 3rpx solid #201b17; border-radius: 12rpx; background: #fffdf5; box-shadow: 4rpx 4rpx 0 #d9cbb0; }
.student-row:active { transform: translate(3rpx, 3rpx); box-shadow: 1rpx 1rpx 0 #d9cbb0; }
.student-name { color: #201b17; font-weight: 800; }
.school-no { color: #75695e; }
.chevron { color: #d64541; font-weight: 900; }
