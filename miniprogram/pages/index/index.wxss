@import "../../tokens.wxss";
.page { min-height:100vh; padding:44rpx 32rpx 96rpx; }
.topline,.section-head { display:flex; align-items:center; justify-content:space-between; }
.eyebrow,.section-kicker { color:#c65a32; font-size:20rpx; letter-spacing:3rpx; font-weight:700; }
.status-dot { color:#74836e; font-size:22rpx; }
.title { margin:14rpx 0 12rpx; color:#202a32; font-family:"Noto Serif SC","Songti SC",serif; font-size:64rpx; font-weight:700; letter-spacing:-2rpx; }
.lead { max-width:580rpx; color:#74808a; font-size:27rpx; line-height:1.7; }
.state,.empty { margin-top:24rpx; color:#74808a; line-height:1.6; }
.error { color:#b94a3a; }
.section-head { margin-top:54rpx; align-items:flex-end; }
.section-title { display:block; margin-top:8rpx; color:#202a32; font-size:30rpx; font-weight:700; }
.section-count { color:#9b9b91; font-size:22rpx; }
.student-heading { margin-top:48rpx; }
.class-list { display:flex; width:calc(100% + 64rpx); margin-top:22rpx; margin-left:-32rpx; padding:0 32rpx; white-space:nowrap; }
.class-chip { display:inline-block; margin-right:14rpx; padding:18rpx 26rpx; border:1rpx solid #ded8cc; border-radius:12rpx; background:#fffdf8; color:#5f6b72; font-size:26rpx; }
.class-chip.active { border-color:#c65a32; background:#c65a32; color:#fffdf8; box-shadow:8rpx 8rpx 0 #e7c9b9; }
.paper-panel { border:1rpx solid #ded8cc; border-radius:16rpx; background:#fffdf8; box-shadow:0 10rpx 24rpx rgba(52,45,35,.05); }
.student-list { margin-top:20rpx; overflow:hidden; }
.student-row { display:flex; align-items:center; justify-content:space-between; padding:24rpx 26rpx; border-bottom:1rpx solid #eee9df; color:#34424a; font-size:27rpx; }
.student-row:last-child { border-bottom:0; }
.school-no { color:#a4a39a; font-size:22rpx; }
.empty-panel { padding:28rpx; border:1rpx dashed #cfc8bb; background:rgba(255,253,248,.6); }
.home-note { display:flex; gap:14rpx; margin-top:48rpx; padding-top:22rpx; border-top:1rpx solid #ded8cc; color:#9b9b91; font-size:21rpx; line-height:1.6; }
.note-mark { color:#c65a32; font-size:30rpx; font-weight:700; }
.page-home { background:#fff4dc; }
.empty-start { margin-top:34rpx; padding:20rpx; border:2rpx solid #201b17; border-radius:14rpx; background:#fff9ea; box-shadow:4rpx 4rpx 0 #201b17; }
.empty-start-head { display:flex; align-items:center; gap:10rpx; color:#d64541; font-size:20rpx; font-weight:900; letter-spacing:2rpx; }
.empty-start-mark { color:#201b17; font-family:"DIN Alternate","Courier New",monospace; font-size:24rpx; }
.empty-start-title { display:block; margin-top:18rpx; color:#201b17; font-size:31rpx; font-weight:900; }
.empty-start-copy { display:block; margin-top:10rpx; color:#685f55; font-size:24rpx; line-height:1.65; }
.empty-start-actions { display:flex; gap:10rpx; margin-top:18rpx; }
.empty-start-actions button { flex:1; font-size:24rpx; }
.welcome-secondary { margin-top:20rpx; }
.error-empty { border-color:#d64541; background:#fff9ea; }
.error-empty .tw-empty-title,.error-empty .tw-empty-copy { display:block; }

.class-list {
  display: flex;
  margin-top: 20rpx;
  white-space: nowrap;
}

.class-chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 999rpx;
  background: #ffffff;
}

.class-chip.active {
  border-color: #2e90fa;
  background: #eff8ff;
  color: #175cd3;
}

.student-list {
  margin-top: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.student-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #eaecf0;
}

.student-row:last-child {
  border-bottom: 0;
}

.school-no {
  color: #667085;
}
