<view class="page">
  <view class="title">{{title}}</view>
  <view wx:if="{{loading}}" class="state">正在读取云端数据…</view>
  <view wx:elif="{{error}}" class="state error">
    <view>{{error}}</view>
    <button wx:if="{{datasetId}}" size="mini" bindtap="retry">重试</button>
  </view>
  <block wx:else>
    <view class="section-title">班级</view>
    <scroll-view wx:if="{{classes.length}}" class="class-list" scroll-x>
      <view
        wx:for="{{classes}}"
        wx:key="uuid"
        class="class-chip {{item.uuid === selectedClassUuid ? 'active' : ''}}"
        data-uuid="{{item.uuid}}"
        bindtap="selectClass"
      >{{item.name || '未命名班级'}}</view>
    </scroll-view>
    <view wx:else class="empty">暂无班级数据</view>

    <view class="section-title">学生</view>
    <view wx:if="{{students.length}}" class="student-list">
      <view wx:for="{{visibleStudents}}" wx:key="uuid" class="student-row">
        <text>{{item.name || '未命名学生'}}</text>
        <text wx:if="{{item.schoolNo}}" class="school-no">{{item.schoolNo}}</text>
      </view>
      <view wx:if="{{!visibleStudents.length}}" class="empty">该班级暂无学生</view>
    </view>
    <view wx:else class="empty">暂无学生数据</view>
  </block>
</view>
