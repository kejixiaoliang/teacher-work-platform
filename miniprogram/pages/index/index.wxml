<view class="page page-home">
  <view class="topline"><text class="eyebrow">01 / TODAY</text><text class="status-dot">教师本人</text></view>
  <view class="title">{{title}}</view>
  <view class="lead">先看班级状态，再处理今天最需要完成的工作。</view>
  <view wx:if="{{loading}}" class="state">正在读取云端数据…</view>
  <view wx:elif="{{error && !datasetId}}" class="tw-empty welcome-empty">
    <text class="tw-empty-title">开始建立你的班级实验本</text>
    <text class="tw-empty-copy">从班级和学生开始，逐步完成考勤、表现、成绩和值日等日常工作。已有电脑端数据可以直接导入。</text>
    <button class="tw-button-primary" bindtap="openImport">导入已有 JSON 数据</button>
    <button class="tw-button-secondary welcome-secondary" bindtap="openWorkbench">先看看工作台</button>
  </view>
  <view wx:elif="{{error}}" class="tw-empty error-empty">
    <text class="tw-empty-title">云端数据暂时不可用</text><text class="tw-empty-copy">{{error}}</text><button class="tw-button-secondary" bindtap="retry">重新连接</button>
  </view>
  <block wx:else>
    <view class="section-head"><view><text class="section-kicker">CLASSROOM</text><text class="section-title">当前班级</text></view><text class="section-count">{{classes.length}} 个</text></view>
    <scroll-view wx:if="{{classes.length}}" class="class-list" scroll-x>
      <view
        wx:for="{{classes}}"
        wx:key="uuid"
        class="class-chip {{item.uuid === selectedClassUuid ? 'active' : ''}}"
        data-uuid="{{item.uuid}}"
        bindtap="selectClass"
      >{{item.name || '未命名班级'}}</view>
    </scroll-view>
    <view wx:else class="empty empty-panel">暂无班级数据</view>

    <view class="section-head student-heading"><view><text class="section-kicker">ROSTER</text><text class="section-title">学生名单</text></view><text class="section-count">{{visibleStudents.length}} 人</text></view>
    <view wx:if="{{students.length}}" class="student-list paper-panel">
      <view wx:for="{{visibleStudents}}" wx:key="uuid" class="student-row">
        <text>{{item.name || '未命名学生'}}</text>
        <text wx:if="{{item.schoolNo}}" class="school-no">{{item.schoolNo}}</text>
      </view>
      <view wx:if="{{!visibleStudents.length}}" class="empty">该班级暂无学生</view>
    </view>
    <view wx:else class="empty empty-panel">暂无学生数据</view>
  </block>
  <view class="home-note"><text class="note-mark">/</text><text>数据来自当前云端数据集，所有记录均按教师身份隔离。</text></view>
</view>
