@import "../../tokens.wxss";
.page{padding:34rpx 24rpx 64rpx}.eyebrow{color:#d64541;font-size:23rpx;font-weight:700;letter-spacing:3rpx}.title{margin:8rpx 0 24rpx;color:#201b17;font-family:"Noto Serif SC","Songti SC",serif;font-size:48rpx;font-weight:900}.picker,.toolbar{box-sizing:border-box;width:100%;margin-top:14rpx;padding:18rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#f2c84b;color:#201b17;font-weight:700}.toolbar{display:flex;align-items:center;justify-content:space-between}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:16rpx}.card{padding:22rpx 8rpx;text-align:center;border:3rpx solid #201b17;border-radius:12rpx;background:#8bd6af;box-shadow:4rpx 4rpx 0 #d9cbb0}.card text,.card label{display:block}.card text{font-size:38rpx;font-weight:800;color:#201b17}.card label{margin-top:8rpx;font-size:20rpx;color:#5f554b}.state{margin-top:24rpx;padding:18rpx;border:2rpx dashed #201b17;color:#5f554b}.error{margin-top:18rpx;color:#a8322e}
.overview{grid-template-columns:repeat(2,1fr)}.section{margin-top:20rpx;padding:20rpx;border:3rpx solid #201b17;border-radius:14rpx;background:#fffdf5;box-shadow:4rpx 4rpx 0 #d9cbb0}.section-title{font-size:28rpx;font-weight:900;color:#201b17}.metric-row{display:flex;justify-content:space-between;gap:16rpx;margin-top:12rpx;padding:12rpx 0;border-bottom:2rpx dashed #d9cbb0;color:#3c352f}.metric-row:last-child{border-bottom:0}.empty-line{margin-top:14rpx;color:#776a5e}.card.compact{padding:14rpx 6rpx}.card.compact text{font-size:30rpx}
.warning{margin-top:16rpx;padding:16rpx;border:3rpx solid #201b17;border-radius:12rpx;background:#fff0cc;color:#8a4d12;font-weight:700}
