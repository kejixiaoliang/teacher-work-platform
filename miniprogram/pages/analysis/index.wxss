.page{padding:40rpx 24rpx 60rpx}.eyebrow{color:#b54708;font-size:24rpx;letter-spacing:2rpx}.title{margin:10rpx 0 28rpx;color:#1d2939;font-size:48rpx;font-weight:700}.picker,.toolbar{box-sizing:border-box;width:100%;margin-top:16rpx;padding:20rpx;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fffdf9}.toolbar{display:flex;align-items:center;justify-content:space-between;font-weight:700}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:16rpx}.card{padding:24rpx 8rpx;text-align:center;border:1rpx solid #eadfd5;border-radius:16rpx;background:#fef0c7}.card text,.card label{display:block}.card text{font-size:38rpx;font-weight:700;color:#1d2939}.card label{margin-top:8rpx;font-size:20rpx;color:#667085}.state{margin-top:28rpx;color:#667085}.error{margin-top:18rpx;color:#b42318}
