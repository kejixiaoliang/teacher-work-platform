<view class="page"><view class="eyebrow">成绩与资料</view><view class="title">数据分析</view><picker mode="selector" range="{{classes}}" range-key="name" bindchange="selectClass"><view class="picker">{{classUuid ? '当前班级：' + classes[0].name : '选择班级'}}</view></picker><view class="toolbar"><text>数据概览</text><button size="mini" bindtap="refresh">刷新</button></view><view wx:if="{{loading}}" class="state">正在读取分析数据…</view><view wx:elif="{{!counts.length}}" class="state">暂无分析数据</view><view wx:else class="grid"><view wx:for="{{counts}}" wx:key="key" class="card"><text>{{item.value}}</text><label>{{item.label}}</label></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
